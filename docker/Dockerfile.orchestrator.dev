# =============================================================================
# Orchestrator Dockerfile — DEV variant for Tilt-driven inner-loop dev
# =============================================================================
#
# Differences from the production `Dockerfile.orchestrator`:
#   - Runs uvicorn with --reload + --reload-dir so Tilt's live_update sync
#     into /app picks up file changes without a full pod restart.
#   - Drops the non-root `srw` user — Tilt's sync writes to /app and a
#     permission mismatch trips the sync.
#   - Same builder stage + same runtime apt set, so the build cache mostly
#     overlaps with the prod image (you don't pay a separate cold build).
#
# Production parity is intentionally not preserved; this image is dev-only.
# `knowledge-base/knowledge/features/tilt_inner_loop_dev.md` has the design rationale.
# =============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/ ./requirements/
COPY scripts/lock_dependencies.py ./scripts/
COPY src/orchestrator/requirements.txt ./src/orchestrator/requirements.txt
RUN python scripts/lock_dependencies.py check orchestrator \
    && pip install --no-cache-dir --require-hashes -r requirements/locks/orchestrator-py311.txt

# -----------------------------------------------------------------------------
# Dev runtime
# -----------------------------------------------------------------------------
FROM python:3.11-slim

LABEL maintainer="SRW Team"
LABEL description="Orchestrator API — dev image with uvicorn --reload"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONSAFEPATH=1 \
    PORT=8085

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    libmagic1 \
    openssh-client \
    rclone \
    zstd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Preserve the same installed package layout as the production image.
COPY src/orchestrator/ /app/src/orchestrator/
COPY src/shared/ /app/src/shared/
COPY config/ /app/config/
COPY pyproject.toml /app/
RUN pip install --no-cache-dir --no-deps -e .

RUN --network=none \
    --mount=type=bind,source=requirements,target=/app/requirements \
    --mount=type=bind,source=scripts/lock_dependencies.py,target=/app/scripts/lock_dependencies.py \
    python -I /app/scripts/lock_dependencies.py check orchestrator --installed \
    && python -m pip check

# Check generated SDK auth and token refresh in this final installed environment.
# The bind mount is build-only; the probe never reads credentials or uses a network.
RUN --network=none --mount=type=bind,source=scripts/check_kubernetes_sdk_auth.py,target=/tmp/check_kubernetes_sdk_auth.py \
    python -I /tmp/check_kubernetes_sdk_auth.py

# Keep the metering package and the main entrypoint image-atomic. This import
# catches selective/stale build contexts before Kubernetes sees the image.
RUN python -c "import orchestrator.services.infrastructure_metering.compute_activation"
# The always-on session-memory drain must remain importable from the lean
# orchestrator dependency set; importing through agent.api would pull agent-only
# checkpoint dependencies and fail only after the Pod starts.
RUN python -c "import orchestrator.services.session_memory_executor"
# Cloud-push admission must also work with orchestrator-only dependencies.
RUN python -c "from orchestrator.services.cloud_push_recovery import build_cloud_push_bundle"
# Keep the manifest schema available with the same lean dependencies as production.
RUN --network=none python -I -c "from shared.manifests import load_schema; assert load_schema()['properties']['apiVersion']['const'] == 'srw/v1alpha1'"
# The VM inventory router needs shared.vm_resource_inventory_settings at
# runtime (deferred import), so prove the shared tree is complete and stays
# importable under this image's lean locked set — same family as the probes
# above. Limit: these guards live in the watched tree, so a wholesale tree
# swap can replace them too; branch-changing work belongs in a separate
# worktree (see Tiltfile operational rule).
RUN --network=none python -I -c "import shared.vm_resource_inventory_settings"

EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/health || exit 1

# uvicorn --reload re-imports changed modules without restarting the container.
# --reload-dir keeps the watcher off bytecode caches and tests/.
CMD ["uvicorn", "orchestrator.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8085", \
     "--timeout-graceful-shutdown", "10", \
     "--reload", \
     "--reload-dir", "/app/src", \
     "--reload-dir", "/app/config"]
