# =============================================================================
# Workspace Container — Sandboxed execution environment for agent jobs
# =============================================================================
#
# Two targets:
#   minimal  the SRW workspace contract, the browser stack and a small CLI
#            set. Published as srw-workspace-minimal.
#   full     minimal plus toolchains, database clients and document tools.
#            Published as srw-workspace; the default target.
# The agent connects via RemoteBackend (SSH/SFTP) — identical to VM workspaces.
#
# Does NOT include: Python agent code, LLM libraries, PyTorch.
# =============================================================================

FROM ubuntu:24.04 AS minimal

ARG SRW_SOURCE_REVISION=""
ARG SRW_SOURCE_URL="https://github.com/superhuman-remote-worker/srw"
ARG SRW_RELEASE_VERSION=""
ARG SRW_DOCUMENTATION_URL="https://github.com/superhuman-remote-worker/srw"
ARG DEBIAN_FRONTEND=noninteractive
ARG CODE_SERVER_VERSION=4.100.3
# Pinned upstream rclone (Ubuntu's packaged 1.60.1-DEV predates the webdav
# `infinitescale` vendor needed for OpenCloud mounts and lacks modern VFS
# cache flags — see knowledge-base/knowledge/features/rclone_cloud_mount.md §12). Keep version
# and checksum in sync with docker/agent-vm-base/scripts/provision-stage1.sh.
# SRW_ prefix is load-bearing: rclone parses RCLONE_* env vars as flags, so
# an ARG named RCLONE_VERSION crashes `rclone version` inside the RUN.
ARG SRW_RCLONE_VERSION=1.74.3
ARG SRW_RCLONE_SHA256=408cde598307dedc26b7108553cb2147a8d2d12853100447e802f47454582ecc

LABEL org.opencontainers.image.source="${SRW_SOURCE_URL}"
LABEL org.opencontainers.image.revision="${SRW_SOURCE_REVISION}"
LABEL org.opencontainers.image.version="${SRW_RELEASE_VERSION}"
LABEL org.opencontainers.image.documentation="${SRW_DOCUMENTATION_URL}"
LABEL io.srw.component="workspace"
LABEL io.srw.workspace.variant="minimal"

ENV SRW_COMPONENT=workspace \
    SRW_SOURCE_REVISION=${SRW_SOURCE_REVISION} \
    SRW_SOURCE_URL=${SRW_SOURCE_URL} \
    SRW_RELEASE_VERSION=${SRW_RELEASE_VERSION} \
    SRW_DOCUMENTATION_URL=${SRW_DOCUMENTATION_URL}

# ---------------------------------------------------------------------------
# 0. Apt tuning: prefer Azure mirror (faster from GHA Azure runners) but keep
#    archive.ubuntu.com as a fallback so apt rotates to it when Azure has an
#    outage (we ate a 23-min hang on 2026-05-05 when Azure stopped responding).
#    Short timeouts + retries make failures fast instead of stalling the build.
# ---------------------------------------------------------------------------
RUN { sed -i 's|http://archive\.ubuntu\.com/ubuntu|http://azure.archive.ubuntu.com/ubuntu|g; s|http://security\.ubuntu\.com/ubuntu|http://azure.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null \
      || sed -i 's|http://archive\.ubuntu\.com/ubuntu|http://azure.archive.ubuntu.com/ubuntu|g; s|http://security\.ubuntu\.com/ubuntu|http://azure.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list; } \
    && printf 'deb http://archive.ubuntu.com/ubuntu noble main restricted universe multiverse\ndeb http://archive.ubuntu.com/ubuntu noble-updates main restricted universe multiverse\ndeb http://security.ubuntu.com/ubuntu noble-security main restricted universe multiverse\n' \
        > /etc/apt/sources.list.d/ubuntu-fallback.list \
    && printf 'Acquire::Retries "5";\nAcquire::Retries::Delay::Maximum "10";\nAcquire::http::Timeout "15";\nAcquire::https::Timeout "15";\nAcquire::http::ConnectionAttemptDelayMsec "500";\nAcquire::http::Pipeline-Depth "10";\nAPT::Install-Recommends "false";\n' \
        > /etc/apt/apt.conf.d/99-build-tuning \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# ---------------------------------------------------------------------------
# 1. Contract and small CLI packages
# ---------------------------------------------------------------------------
# Install eatmydata first (small, cached forever in practice), then use it to
# wrap the big install — eatmydata noop's dpkg's fsync calls (~30-50% faster).
# APT::Install-Recommends is disabled globally via /etc/apt/apt.conf.d/99-build-tuning.
# BuildKit cache mounts hold /var/cache/apt + /var/lib/apt across RUNs in this
# build (and across rebuilds when the layer is cache-busted but apt cache
# survives), so no &&rm -rf cleanup is needed — the lists never live in the layer.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update -y \
    && apt-get install -y eatmydata \
    && eatmydata apt-get install -y \
    openssh-server \
    tmux \
    git \
    curl \
    wget \
    jq \
    vim-tiny \
    nano \
    less \
    procps \
    zip \
    unzip \
    zstd \
    fuse3 \
    fuse-overlayfs \
    # NOTE: sudo intentionally excluded — agent-host must not escalate to root
    ca-certificates \
    ripgrep \
    python3 \
    python3-venv \
    python3-pip

# Ensure python points to python3
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1 || true

# ---------------------------------------------------------------------------
# 1c. rclone — pinned upstream release with checksum verification (not apt:
#     Noble ships 1.60.1-DEV, too old for OpenCloud's webdav vendor). The deb
#     replaces any distro rclone and lands in /usr/bin/rclone.
# ---------------------------------------------------------------------------
RUN curl -fsSL "https://downloads.rclone.org/v${SRW_RCLONE_VERSION}/rclone-v${SRW_RCLONE_VERSION}-linux-amd64.deb" \
        -o /tmp/rclone.deb \
    && echo "${SRW_RCLONE_SHA256}  /tmp/rclone.deb" | sha256sum -c - \
    && dpkg -i /tmp/rclone.deb \
    && rm /tmp/rclone.deb \
    && rclone version

# fuse-overlayfs version gate — the overlay-over-rclone spike (see
# knowledge-base/knowledge/superpowers/plans/2026-07-09-protected-cloud-mode-phase0-spike.md)
# needs the big-dir/readdir fixes that landed in 1.13. Fail the build loudly
# rather than silently shipping a too-old binary.
#
# The sed must be anchored to the tool's own "fuse-overlayfs: version X"
# line: `--version` also prints the FUSE library version and the FUSE
# kernel interface version, each on their own "... version N.N" line, so
# an unanchored `.*version \(...\)` pattern matches all three lines and
# `$v` becomes a multi-line string that makes `dpkg --compare-versions`
# print "bad syntax" on every build.
RUN fuse-overlayfs --version \
    && v="$(fuse-overlayfs --version | sed -n 's/^fuse-overlayfs: version \([0-9.]*\).*/\1/p')" \
    && dpkg --compare-versions "$v" ge 1.13 \
        || { echo "fuse-overlayfs $v < 1.13 (big-dir/readdir fixes needed)"; exit 1; }

# ---------------------------------------------------------------------------
# 2b. Chromium via Playwright (replaces apt chromium-browser, which on Ubuntu
#     Noble is a snap shim — see docker/agent-vm-base/scripts/provision-stage1.sh).
#     PLAYWRIGHT_VERSION must match .playwright-version (also consumed by
#     provision.sh). The agent image has no Playwright/Chromium at all.
# ---------------------------------------------------------------------------
ARG PLAYWRIGHT_VERSION=1.59.0
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/root/.cache/pip \
    test -n "$PLAYWRIGHT_VERSION" || (echo "PLAYWRIGHT_VERSION build-arg required" && exit 1) \
    # browser-use is CAPPED below 0.13.0: 0.13 (2026-06-08) rewrote the browser
    # layer to pure CDP and dropped Playwright, so it no longer finds the
    # Playwright-installed Chromium under PLAYWRIGHT_BROWSERS_PATH and falls back
    # to auto-installing one via `uvx playwright install` — which fails on this
    # image ([Errno 2] No such file or directory: 'uvx'), breaking every
    # browser_* tool cluster-wide. 0.12.x (validated 2026-05-27) is the last
    # Playwright-compatible line the browser-exec daemon is written against. Do
    # NOT loosen this cap without upgrading docker/browser-exec to the 0.13 API.
    && eatmydata pip install --break-system-packages "playwright==${PLAYWRIGHT_VERSION}" "browser-use>=0.12.9,<0.13.0" \
    && apt-get update -y && eatmydata apt-get install -y fonts-noto-core \
    && PLAYWRIGHT_BROWSERS_PATH=/opt/playwright eatmydata playwright install --with-deps chromium \
    # Layout varies by version: older revs use chrome-linux/, newer (>=1.49) use
    # chrome-linux64/. Match both; exclude the headless-shell directory.
    && CHROMIUM_BIN=$(find /opt/playwright -maxdepth 4 -type f \( -path '*/chrome-linux/chrome' -o -path '*/chrome-linux64/chrome' \) ! -path '*headless_shell*' | head -1) \
    && test -n "$CHROMIUM_BIN" || (echo "chromium binary not found under /opt/playwright" && find /opt/playwright -maxdepth 4 -type d && exit 1) \
    && ln -sf "$CHROMIUM_BIN" /usr/local/bin/agent-chromium \
    && rm -rf /root/.cache/ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

# ---------------------------------------------------------------------------
# 2c. browser-exec — workspace-side browser executor. The agent drives it over
#     SSH (exec_command), so Chrome's CDP stays on the workspace loopback and
#     never crosses the pod network. See knowledge-base/knowledge/features/browser_workspace_executor.md
# ---------------------------------------------------------------------------
# The workspace user needs read and execute access even from a private checkout.
COPY --chmod=0755 docker/browser-exec /usr/local/bin/browser-exec

# ---------------------------------------------------------------------------
# 2d. Browser stack conformance gate — the SAME script the VM golden image runs
#     at the end of stage2 (docker/agent-vm-base). Shared, not duplicated: these
#     two images are hand-maintained twins, and the VM shipped for ~5 weeks with
#     a working Chromium that no agent could reach because browser-exec and
#     browser-use were added here only, with nothing asserting the images agreed.
#     See knowledge-base/knowledge/issues/vm_workspace_missing_browser_exec.md. Installed permanently
#     as well as run, so any live workspace can be interrogated in five seconds.
# ---------------------------------------------------------------------------
COPY --chmod=0755 docker/check-browser-stream.py /usr/local/bin/check-browser-stream
COPY --chmod=0755 docker/assert-browser-stack.sh /usr/local/bin/assert-browser-stack
RUN /usr/local/bin/assert-browser-stack

# ---------------------------------------------------------------------------
# 3. code-server (IDE)
# ---------------------------------------------------------------------------
RUN curl --http1.1 --retry 3 --retry-all-errors --connect-timeout 15 --max-time 1800 \
        -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_amd64.deb" \
        -o /tmp/code-server.deb \
    && dpkg -i /tmp/code-server.deb \
    && rm /tmp/code-server.deb

# ---------------------------------------------------------------------------
# 4. User setup (mirrors provision.sh lines 111-131)
# ---------------------------------------------------------------------------
RUN userdel -r $(getent passwd 1000 | cut -d: -f1) 2>/dev/null || true \
    && useradd -m -s /bin/bash -u 1000 agent-host

# SSH authorized_keys outside home dir — keeps ~ clean for workspace use.
# sshd StrictModes requires root ownership on this path, which the entrypoint
# (running as root) satisfies trivially.
RUN mkdir -p /etc/ssh/authorized_keys \
    && chmod 755 /etc/ssh/authorized_keys

# User-writable package directories (pip/npm without sudo)
RUN mkdir -p /home/agent-host/.local/bin \
             /home/agent-host/.local/lib/python3/site-packages \
             /home/agent-host/.npm-global \
             /home/agent-host/.cache \
             /cloud \
    && chown -R agent-host:agent-host /home/agent-host /cloud

ENV PIP_TARGET=/home/agent-host/.local/lib/python3/site-packages \
    PATH="/home/agent-host/.local/bin:/home/agent-host/.npm-global/bin:${PATH}" \
    npm_config_prefix=/home/agent-host/.npm-global

# ---------------------------------------------------------------------------
# 5. SSH server config (mirrors provision.sh lines 141-155)
# ---------------------------------------------------------------------------
RUN mkdir -p /run/sshd \
    && tee /etc/ssh/sshd_config.d/agent.conf > /dev/null <<'SSHEOF'
# Workspace container SSH config — optimized for RemoteBackend
# Listener on 30022 (not 22): removes the egress/ingress port alias on
# TCP/22 and is defense-in-depth against future NetworkPolicy drift.
# See knowledge-base/knowledge/features/workspace_network_isolation.md (PR 2).
Port 30022
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /etc/ssh/authorized_keys/%u
# Certificates minted by the ssh-gateway's user CA. The gateway signs a fresh
# key per attachment with a validity measured in minutes, so no standing
# credential for this workspace exists anywhere outside the workspace itself.
# The agent's own access still uses AuthorizedKeysFile above.
TrustedUserCAKeys /etc/ssh/srw_user_ca.pub
# Every workspace image bakes in the same Unix user (agent-host) and trusts
# the same CA, so TrustedUserCAKeys alone would let a certificate minted for
# ANY workspace authenticate to THIS one for its whole validity window. This
# file (written at boot by the entrypoint from this workspace's own owner
# id) restricts accepted certificates to the one principal the gateway
# mints for this specific workspace, regardless of the shared login name.
AuthorizedPrincipalsFile /etc/ssh/principals/%u
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
# Canvas reaches declared workspace HTTP ports only through request-scoped
# direct-tcpip channels on this authenticated SSH transport. Keep forwarding
# local to the SSH client, restrict its destination to workspace loopback, and
# disable the unrelated forwarding/tunnel surfaces explicitly.
AllowTcpForwarding local
PermitOpen 127.0.0.1:*
GatewayPorts no
AllowAgentForwarding no
PermitTunnel no
# Keep connections alive (agent may have idle periods between tool calls)
ClientAliveInterval 60
ClientAliveCountMax 720
MaxStartups 10:30:100
# Above the OpenSSH default (10): the agent multiplexes parallel tool execs
# plus persistent SFTP/shell channels over ONE transport, and a 14-wide tool
# batch at the default limit masqueraded as workspace death. The backend caps
# concurrent execs at WORKSPACE_SSH_MAX_CONCURRENT_CHANNELS (10); 16 leaves
# headroom for the long-lived channels.
# knowledge-base/knowledge/issues/maxsessions_parallel_tools_false_workspace_death.md
MaxSessions 16
SSHEOF

# Host keys are generated at runtime into the workspace-system volume. Baking
# them into the image would give every workspace the same SSH identity.
RUN rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub

# ---------------------------------------------------------------------------
# 6. tmux config (mirrors provision.sh lines 255-262)
# ---------------------------------------------------------------------------
RUN tee /home/agent-host/.tmux.conf > /dev/null <<'TMUXEOF'
# Increase scrollback buffer
set-option -g history-limit 50000
# Mouse support
set -g mouse on
# 256 colors
set -g default-terminal "screen-256color"
TMUXEOF
RUN chown agent-host:agent-host /home/agent-host/.tmux.conf

# ---------------------------------------------------------------------------
# 7. Git config (mirrors provision.sh lines 270-273)
# ---------------------------------------------------------------------------
RUN su -c 'git config --global init.defaultBranch main' agent-host \
    && su -c 'git config --global user.name "Agent Worker"' agent-host \
    && su -c 'git config --global user.email "agent@srw.local"' agent-host \
    && su -c 'git config --global core.editor vim' agent-host \
    && su -c 'git config --global core.pager cat' agent-host

# ---------------------------------------------------------------------------
# 8. code-server config (state outside home so it doesn't clutter workspace)
# ---------------------------------------------------------------------------
RUN mkdir -p /home/agent-host/.config/code-server \
    && tee /home/agent-host/.config/code-server/config.yaml > /dev/null <<'CSEOF'
bind-addr: 0.0.0.0:38080
# Never `auth: none`. The entrypoint writes the real config (with the
# orchestrator-derived per-workspace credential) to
# /var/lib/code-server/.srw-auth.yaml and passes it via --config; this file is
# shadowed by the workspace PVC mount at /home/agent-host anyway. It stays
# `password` so that any invocation which somehow reads it still refuses
# anonymous callers instead of serving the workspace to the Pod network.
auth: password
cert: false
disable-telemetry: true
CSEOF
RUN chown -R agent-host:agent-host /home/agent-host/.config

# code-server user-data and extensions live outside home — survives volume
# mounts and keeps the IDE file explorer clean.
RUN mkdir -p /var/lib/code-server/User \
             /var/lib/code-server/extensions \
    && tee /var/lib/code-server/User/settings.json > /dev/null <<'VSEOF'
{
    "files.exclude": {
        "**/.bashrc": true,
        "**/.bash_logout": true,
        "**/.bash_history": true,
        "**/.profile": true,
        "**/.gitconfig": true,
        "**/.tmux.conf": true,
        "**/.config": true,
        "**/.local": true,
        "**/.cache": true,
        "**/.npm-global": true,
        "**/.workspace-initialized": true
    }
}
VSEOF
RUN chown -R agent-host:agent-host /var/lib/code-server

# ---------------------------------------------------------------------------
# 9. Dotfile skeleton — volume mounts shadow baked-in files, so stage a copy
#    that the entrypoint seeds on first boot.
# ---------------------------------------------------------------------------
RUN cp -a /home/agent-host /etc/skel.agent-host

# ---------------------------------------------------------------------------
# 10. Entrypoint — SSHD (foreground) + code-server (background)
# ---------------------------------------------------------------------------
COPY --chmod=0755 docker/workspace-entrypoint.sh /usr/local/bin/entrypoint.sh

# ---------------------------------------------------------------------------
# 11. Workspace contract gate. Fails the build when something the
#     orchestrator needs is missing. Installed permanently as well as run, so
#     any image built FROM this one can run it too.
# ---------------------------------------------------------------------------
COPY --chmod=0755 docker/assert-workspace-contract.sh /usr/local/bin/assert-workspace-contract
RUN /usr/local/bin/assert-workspace-contract

EXPOSE 30022 38080 9222

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# =============================================================================
# full — minimal plus toolchains, database clients and document tools
# =============================================================================
FROM minimal AS full

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_MAJOR=22

LABEL io.srw.workspace.variant="full"

# ---------------------------------------------------------------------------
# F1. Toolchains, document tools and network utilities
# ---------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update -y \
    && eatmydata apt-get install -y \
    tree \
    htop \
    net-tools \
    iproute2 \
    dnsutils \
    iputils-ping \
    gnupg \
    lsb-release \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    libffi-dev \
    libpq-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    fd-find \
    poppler-utils \
    pandoc \
    ffmpeg \
    fonts-dejavu-core \
    fonts-dejavu-mono \
    python3-dev

# ---------------------------------------------------------------------------
# F2. Datasource CLI clients (psql, mongosh, cypher-shell)
#     Needed for read-write datasource mode — agent runs queries via shell.
#     Mirrors agent-vm-base/scripts/provision-stage1.sh section 1b.
# ---------------------------------------------------------------------------

# Datasource CLI clients (psql, mongosh, cypher-shell). Add MongoDB + Neo4j
# repos first, then a single apt-get update + install for all three packages
# (postgresql-client comes from Ubuntu's default repos so no custom source).
# One update instead of three; mirrors agent-vm-base provision.sh.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    curl -fsSL https://www.mongodb.org/static/pgp/server-8.0.asc \
        | gpg --dearmor -o /usr/share/keyrings/mongodb-server-8.0.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg] https://repo.mongodb.org/apt/ubuntu noble/mongodb-org/8.0 multiverse" \
        > /etc/apt/sources.list.d/mongodb-org-8.0.list \
    && curl -fsSL https://debian.neo4j.com/neotechnology.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/neo4j-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/neo4j-archive-keyring.gpg] https://debian.neo4j.com stable latest" \
        > /etc/apt/sources.list.d/neo4j.list \
    && apt-get update -y \
    && eatmydata apt-get install -y \
        postgresql-client \
        mongodb-mongosh \
        openjdk-17-jre-headless \
        cypher-shell

# ---------------------------------------------------------------------------
# F3. Node.js 22 + global packages
# ---------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/root/.npm \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && eatmydata apt-get install -y nodejs \
    # Trimmed global npm — typescript + prettier only (commonly invoked).
    # ts-node, @angular/cli, eslint, yarn had zero usage in src/ or config/;
    # corepack provides yarn/pnpm shims on demand if a job actually needs them.
    # `env -u`: minimal points npm_config_prefix at the home directory for
    # the user's own installs. These must land system-wide instead.
    && env -u npm_config_prefix npm install -g \
        typescript \
        prettier \
    && env -u npm_config_prefix corepack enable

# ---------------------------------------------------------------------------
# F4. Both gates again: nothing added above may break the contract or the
#     browser stack.
# ---------------------------------------------------------------------------
RUN /usr/local/bin/assert-workspace-contract
RUN /usr/local/bin/assert-browser-stack
