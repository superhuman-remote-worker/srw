# =============================================================================
# Universal Agent Dockerfile
# =============================================================================
#
# A unified Docker image for any agent configuration.
# The agent behavior is determined by the AGENT_CONFIG environment variable.
#
# Build:
#   docker build -t srw-agent -f docker/Dockerfile.agent .
#
# Run with defaults:
#   docker run -p 8001:8001 \
#     -e DATABASE_URL=postgresql://... \
#     -e OPENAI_API_KEY=... \
#     srw-agent
#
# Run with custom config:
#   docker run -p 8001:8001 \
#     -e AGENT_CONFIG=my_agent \
#     -e DATABASE_URL=postgresql://... \
#     -e OPENAI_API_KEY=... \
#     srw-agent
#
# Entry point: python -m agent (Universal Agent CLI)
# =============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies (git needed for pip install from git URLs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch first (separate layer — rarely changes, ~200MB vs ~2GB with CUDA)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# The citation_engine package lives under src/ (src/agent/citation_engine/) and is
# COPY'd with the rest of src/ below — no separate install. Its runtime deps
# are in requirements.txt.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Production image
FROM python:3.11-slim

ARG SRW_SOURCE_REVISION=""
ARG SRW_SOURCE_URL="https://github.com/superhuman-remote-worker/srw"
ARG SRW_RELEASE_VERSION=""
ARG SRW_DOCUMENTATION_URL="https://github.com/superhuman-remote-worker/srw"

LABEL maintainer="SRW Team"
LABEL description="Universal Agent for document processing and requirement validation"
LABEL org.opencontainers.image.source="${SRW_SOURCE_URL}"
LABEL org.opencontainers.image.revision="${SRW_SOURCE_REVISION}"
LABEL org.opencontainers.image.version="${SRW_RELEASE_VERSION}"
LABEL org.opencontainers.image.documentation="${SRW_DOCUMENTATION_URL}"
LABEL io.srw.component="agent"

# Create non-root user early so COPY --chown can reference it
RUN groupadd -r srw && useradd -r -g srw -m srw

# Build SHA for stale-image detection (passed via --build-arg)
ARG BUILD_SHA=""
ARG UV_VERSION="0.7.12"
# Pinned upstream rclone for the `virtual` tier's object store and its cloud
# folders (bookworm packages 1.60.1, which predates `rcat --size`, the WebDAV
# vendors a cloud folder needs and the Nextcloud fixes of 1.75.1). Keep version
# and checksum in sync with docker/Dockerfile.workspace (the same values);
# tests/test_workspace_image_targets.py checks that they agree. The SRW_
# prefix is load-bearing: rclone parses RCLONE_* env vars as flags.
ARG SRW_RCLONE_VERSION=1.75.2
ARG SRW_RCLONE_SHA256=efbfe852181f7191eb3c9043ed1ab49c9b2d0ba045c61c926a5da111c939ec5c

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONSAFEPATH=1 \
    AGENT_CONFIG=defaults \
    AGENT_PORT=8001 \
    BUILD_SHA=${BUILD_SHA} \
    SRW_COMPONENT=agent \
    SRW_SOURCE_REVISION=${SRW_SOURCE_REVISION} \
    SRW_SOURCE_URL=${SRW_SOURCE_URL} \
    SRW_RELEASE_VERSION=${SRW_RELEASE_VERSION} \
    SRW_DOCUMENTATION_URL=${SRW_DOCUMENTATION_URL}

WORKDIR /app

# Install curl first (needed for NodeSource setup), then add Node.js 22 repo
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && rm -rf /var/lib/apt/lists/*

# Install runtime dependencies. Document/media processing runs in-process;
# code execution (shell, browser) happens on the workspace, not in this pod.
# rclone is the exception that proves the rule: a fixed-destination typed
# client (no_workspace_agent_mode.md §3.1) used only by the `virtual` tier's
# object-store backend; it is installed pinned below, not from apt.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    poppler-utils \
    ffmpeg \
    ripgrep \
    jq \
    nodejs \
    build-essential \
    cmake \
    python3-dev \
    libffi-dev \
    vim-tiny \
    less \
    tree \
    htop \
    procps \
    net-tools \
    iproute2 \
    dnsutils \
    openssh-client \
    zip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# rclone: pinned upstream release with checksum verification (the workspace
# image's mechanism). The deb lands in /usr/bin/rclone.
RUN curl -fsSL "https://downloads.rclone.org/v${SRW_RCLONE_VERSION}/rclone-v${SRW_RCLONE_VERSION}-linux-amd64.deb" \
        -o /tmp/rclone.deb \
    && echo "${SRW_RCLONE_SHA256}  /tmp/rclone.deb" | sha256sum -c - \
    && dpkg -i /tmp/rclone.deb \
    && rm /tmp/rclone.deb \
    && rclone version

# MCP stdio runtimes: NodeSource's nodejs package supplies node/npm/npx above;
# uv supplies the Python server launcher (uvx). Keep uv exact-pinned so an
# agent-image rebuild cannot silently change subprocess behavior.
RUN pip install --no-cache-dir "uv==${UV_VERSION}"

# Copy installed packages from builder (system-owned, read-only is fine)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Bake tokenizer assets before source changes. Runtime counting must not block
# the event loop on lazy downloads or fall back because an asset is missing.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
# Private workspace checkouts can be mode 0600; the final srw user must read it.
COPY --chmod=0644 docker/prepare-tokenizer-cache.py /usr/local/bin/prepare-tokenizer-cache.py
RUN python /usr/local/bin/prepare-tokenizer-cache.py prepare

# No browser in the agent image — Chromium lives on the workspace image only
# (browser-exec daemon). See knowledge-base/knowledge/issues/remove_local_browser_fallback.md.

# Copy source code LAST (changes most frequently)
COPY --chown=srw:srw src/agent/ ./src/agent/
COPY --chown=srw:srw src/shared/ ./src/shared/
COPY --chown=srw:srw config/ ./config/
COPY --chown=srw:srw pyproject.toml ./

# Editable installation keeps imports at the source paths synchronized by Tilt.
RUN pip install --no-cache-dir --no-deps -e .

# Transitional image-only entry for old/new orchestrators and durable recycle
# targets that still launch `python agent.py`. Keep package resolution canonical;
# the repository has no agent.py shim. Remove only after that compatibility
# window (including rollback targets) has closed.
RUN printf '%s\n' 'import runpy' \
    'runpy.run_module("agent", run_name="__main__", alter_sys=True)' \
    > /app/agent.py

# Older orchestrators also invoke this preStop module name. Provide just this
# image-only namespace entry in system site-packages, with no src/__init__.py
# or api/__init__.py and no alias for the former application source tree.
RUN python - <<'SRW_TERMINATION_COMPAT'
from pathlib import Path
import sysconfig

legacy_dir = Path(sysconfig.get_path("purelib")) / "src" / "api"
legacy_dir.mkdir(parents=True, exist_ok=True)
(legacy_dir / "persistent_termination.py").write_text(
    'import runpy\n'
    'if __name__ == "__main__":\n'
    '    runpy.run_module("agent.api.persistent_termination", '
    'run_name="__main__", alter_sys=True)\n',
    encoding="utf-8",
)
SRW_TERMINATION_COMPAT

# Create runtime directories with correct ownership
RUN mkdir -p /app/workspace /app/logs && \
    chown -R srw:srw /app/workspace /app/logs

# User-writable package directories (pip/npm without sudo)
RUN mkdir -p /home/srw/.local/bin /home/srw/.local/lib/python3.11/site-packages \
             /home/srw/.npm-global /home/srw/.cache \
    && chown -R srw:srw /home/srw

ENV PIP_TARGET=/home/srw/.local/lib/python3.11/site-packages \
    PATH="/home/srw/.local/bin:/home/srw/.npm-global/bin:${PATH}" \
    npm_config_prefix=/home/srw/.npm-global

USER srw

# Load the actual final-filesystem vocabularies and exercise all token counters
# cold, as the runtime user, without network access or approximate fallbacks.
RUN --network=none python /usr/local/bin/prepare-tokenizer-cache.py verify

# Verify the image-only compatibility command and normal module command both
# resolve the installed package, including under the non-root runtime user.
RUN python -c "from pathlib import Path; import agent, sys; assert sys.flags.safe_path; assert Path(agent.__file__).resolve() == Path('/app/src/agent/__init__.py')" \
    && python /app/agent.py --help >/dev/null \
    && python -m agent --help >/dev/null

# Exercise the actual old module command as the runtime user. Mock both the
# sentinel and HTTP request so this build check cannot initiate a real drain.
RUN --network=none python - <<'SRW_TERMINATION_SMOKE'
import importlib.util
from pathlib import Path
import runpy
import sys
from unittest.mock import patch

canonical = "agent.api.persistent_termination"
canonical_file = importlib.util.find_spec(canonical).origin
seen = {}
sys.argv = ["src.api.persistent_termination", "--compatibility-smoke"]


def observe(frame, event, _arg):
    if event == "call" and frame.f_code.co_name == "main":
        if frame.f_code.co_filename == canonical_file:
            seen.update(
                file=frame.f_globals["__file__"],
                package=frame.f_globals["__package__"],
                argv=list(sys.argv),
            )


with patch.object(Path, "mkdir"), patch.object(Path, "touch"):
    with patch("urllib.request.urlopen") as request:
        request.return_value.__enter__.return_value.status = 200
        sys.setprofile(observe)
        try:
            runpy.run_module(
                "src.api.persistent_termination", run_name="__main__", alter_sys=True
            )
        except SystemExit as result:
            assert result.code == 0
        finally:
            sys.setprofile(None)
        request.assert_called_once()
assert seen == {
    "file": canonical_file,
    "package": "agent.api",
    "argv": [canonical_file, "--compatibility-smoke"],
}, seen
SRW_TERMINATION_SMOKE

# Agent image contract gate: fails the build when a program the agent shells
# out to is missing or too old. Installed as well as run, so a live Pod can be
# checked with `assert-agent-contract`.
COPY --chmod=0755 docker/assert-agent-contract.sh /usr/local/bin/assert-agent-contract
RUN /usr/local/bin/assert-agent-contract

# Expose default port (can be overridden)
EXPOSE 8001
EXPOSE 8002

# Health check using the configured port
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${AGENT_PORT}/health || exit 1

# Run the Universal Agent with config from environment
CMD ["sh", "-c", "exec python -m agent --config ${AGENT_CONFIG} --port ${AGENT_PORT} --host 0.0.0.0"]
