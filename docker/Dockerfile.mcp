# =============================================================================
# MCP Server Dockerfile
# =============================================================================
#
# MCP server exposing orchestrator API to LLMs like Claude Code.
# Uses a pinned FastMCP 3.x runtime with dual transport support (stdio/HTTP).
#
# Build:
#   docker build -t srw-mcp -f docker/Dockerfile.mcp .
#
# Run (HTTP transport - default for container):
#   docker run -d --name mcp \
#     -p 8000:8000 \
#     -e COCKPIT_API_URL=http://orchestrator:8085 \
#     srw-mcp
#
# Run (stdio transport - for docker exec):
#   docker run -d --name mcp \
#     -e MCP_TRANSPORT=stdio \
#     -e COCKPIT_API_URL=http://orchestrator:8085 \
#     srw-mcp sleep infinity
#   docker exec -i mcp python -m mcp_server
# =============================================================================

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ARG SRW_SOURCE_REVISION=""
ARG SRW_SOURCE_URL="https://github.com/superhuman-remote-worker/srw"
ARG SRW_RELEASE_VERSION=""
ARG SRW_DOCUMENTATION_URL="https://github.com/superhuman-remote-worker/srw"

LABEL maintainer="SRW Team"
LABEL description="SRW orchestrator-facing MCP server (FastMCP 3.x)"
LABEL org.opencontainers.image.source="${SRW_SOURCE_URL}"
LABEL org.opencontainers.image.revision="${SRW_SOURCE_REVISION}"
LABEL org.opencontainers.image.version="${SRW_RELEASE_VERSION}"
LABEL org.opencontainers.image.documentation="${SRW_DOCUMENTATION_URL}"
LABEL io.srw.component="mcp"

ENV PYTHONUNBUFFERED=1 \
    PYTHONSAFEPATH=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SRW_COMPONENT=mcp \
    SRW_SOURCE_REVISION=${SRW_SOURCE_REVISION} \
    SRW_SOURCE_URL=${SRW_SOURCE_URL} \
    SRW_RELEASE_VERSION=${SRW_RELEASE_VERSION} \
    SRW_DOCUMENTATION_URL=${SRW_DOCUMENTATION_URL}

# Create non-root user early so COPY --chown can reference it. Fixed IDs: the
# chart's OAuth-state volume is group-owned by GID 10001 (fsGroup), which a
# system-assigned ID could not promise.
RUN groupadd -r -g 10001 srw && useradd -r -u 10001 -g srw srw

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY src/mcp_server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy MCP server source code with correct ownership
COPY --chown=srw:srw src/mcp_server/ ./src/mcp_server/
COPY --chown=srw:srw src/shared/ ./src/shared/
COPY --chown=srw:srw pyproject.toml ./
RUN pip install --no-cache-dir --no-deps -e .

# Bake the exact protocol schema into the image. The image smoke test compares
# raw tools/list from two fresh clients against this artifact.
RUN MCP_TRANSPORT=stdio python -m mcp_server.schema_artifact /app/tool-schema.json

USER srw

# Default to HTTP for container deployment
ENV MCP_TRANSPORT=http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8000 \
    MCP_SCHEMA_ARTIFACT=/app/tool-schema.json \
    COCKPIT_API_URL=http://orchestrator:8085

# Validate the exact final filesystem, dependency set, schema artifact, and
# non-root runtime before the image can be exported or pushed by CI.
RUN python -m mcp_server.image_smoke

EXPOSE 8000

# Health check for Kubernetes readiness/liveness probes
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "mcp_server"]
