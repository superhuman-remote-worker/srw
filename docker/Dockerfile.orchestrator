# =============================================================================
# Orchestrator Dockerfile
# =============================================================================
#
# FastAPI backend for agent orchestration and cockpit API.
#
# Build:
#   docker build -t srw-orchestrator -f docker/Dockerfile.orchestrator .
#
# Run:
#   docker run -p 8085:8085 \
#     -e DATABASE_URL=postgresql://... \
#     -e MONGODB_URL=mongodb://... \
#     srw-orchestrator
# =============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Resolve only during an explicit dependency update; builds consume hashed pins.
COPY requirements/ ./requirements/
COPY scripts/lock_dependencies.py ./scripts/
COPY src/orchestrator/requirements.txt ./src/orchestrator/requirements.txt
RUN python scripts/lock_dependencies.py check orchestrator \
    && pip install --no-cache-dir --require-hashes -r requirements/locks/orchestrator-py311.txt

# Production image
FROM python:3.11-slim

ARG SRW_SOURCE_REVISION=""
ARG SRW_SOURCE_URL="https://github.com/superhuman-remote-worker/srw"
ARG SRW_RELEASE_VERSION=""
ARG SRW_DOCUMENTATION_URL="https://github.com/superhuman-remote-worker/srw"

LABEL maintainer="SRW Team"
LABEL description="Orchestrator API for agent management and cockpit backend"
LABEL org.opencontainers.image.source="${SRW_SOURCE_URL}"
LABEL org.opencontainers.image.revision="${SRW_SOURCE_REVISION}"
LABEL org.opencontainers.image.version="${SRW_RELEASE_VERSION}"
LABEL org.opencontainers.image.documentation="${SRW_DOCUMENTATION_URL}"
LABEL io.srw.component="orchestrator"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONSAFEPATH=1 \
    PORT=8085 \
    SRW_COMPONENT=orchestrator \
    SRW_SOURCE_REVISION=${SRW_SOURCE_REVISION} \
    SRW_SOURCE_URL=${SRW_SOURCE_URL} \
    SRW_RELEASE_VERSION=${SRW_RELEASE_VERSION} \
    SRW_DOCUMENTATION_URL=${SRW_DOCUMENTATION_URL}

# Create non-root user early so COPY --chown can reference it
# Keep the runtime identity numeric and stable: Kubernetes cannot prove that a
# named image user satisfies runAsNonRoot, and the collector Pod pins this ID.
RUN groupadd -r -g 999 srw && useradd -r -u 999 -g srw srw

WORKDIR /app

# Install runtime dependencies only.
# openssh-client is required by services/snapshot_service.py to capture
# workspace tarballs from agent VMs over SSH before pod teardown.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    libmagic1 \
    openssh-client \
    rclone \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder (system-owned, read-only is fine)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Bake tokenizer assets before source changes. KB chunking and the LLM request
# preflight count tokens in this process; a lazy vocab download is synchronous
# HTTP that stalls wherever egress DNS fails, and it must never be needed here.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
# Private workspace checkouts can be mode 0600; the final srw user must read it.
COPY --chmod=0644 docker/prepare-tokenizer-cache.py /usr/local/bin/prepare-tokenizer-cache.py
RUN python /usr/local/bin/prepare-tokenizer-cache.py prepare

# Copy only this application and its shared runtime/contracts.
COPY --chown=srw:srw src/orchestrator/ ./src/orchestrator/
COPY --chown=srw:srw src/shared/ ./src/shared/
COPY --chown=srw:srw config/ ./config/
COPY --chown=srw:srw pyproject.toml ./
RUN pip install --no-cache-dir --no-deps -e .

RUN --network=none \
    --mount=type=bind,source=requirements,target=/app/requirements \
    --mount=type=bind,source=scripts/lock_dependencies.py,target=/app/scripts/lock_dependencies.py \
    python -I /app/scripts/lock_dependencies.py check orchestrator --installed \
    && python -m pip check

# Check generated SDK auth and token refresh in this final installed environment.
# The bind mount is build-only; the probe never reads credentials or uses a network.
RUN --network=none --mount=type=bind,source=scripts/check_kubernetes_sdk_auth.py,target=/tmp/check_kubernetes_sdk_auth.py \
    python -I /tmp/check_kubernetes_sdk_auth.py

# Keep the metering package and the main entrypoint image-atomic. This import
# catches selective/stale build contexts before an image can be published.
RUN python -c "import orchestrator.services.infrastructure_metering.compute_activation"
# Fail the image build if the always-on session-memory drain accidentally
# regains an agent-only import dependency.
RUN python -c "import orchestrator.services.session_memory_executor"
# Exercise the installed image namespace and lean dependency set directly.
RUN python -c "import orchestrator.services.email, orchestrator.services.headless_notifications"
# The manifest API must find its authored schema in the installed package.
RUN --network=none python -I -c "from shared.manifests import load_schema; assert load_schema()['properties']['apiVersion']['const'] == 'srw/v1alpha1'"
# The legacy-authority operator must be executable in the same installed
# namespace operators get through ``kubectl exec``.  Keep this as ``--help``:
# image construction must never connect to storage or initialize the forge.
RUN python -m orchestrator.operator_cli.managed_repository_reconciliation --help >/dev/null
# Keep the bounded stateless-wake rollout gate executable through the same
# installed-package import path. ``--help`` is inert and never opens storage.
RUN python -m orchestrator.operator_cli.stateless_wake_acceptance --help >/dev/null
# The Canvas role reconciliation Job runs this same runtime attestation before
# a Helm revision becomes ready. ``--help`` proves the installed image imports
# it without opening a database connection.
RUN python -m orchestrator.operator_cli.canvas_viewer_database_attestation --help >/dev/null
RUN python -m orchestrator.operator_cli.vm_workspace_recovery_acceptance --help >/dev/null

USER srw

# Load the actual final-filesystem vocabularies and exercise the shared token
# counters cold, as the runtime user, without network access or fallbacks.
RUN --network=none python /usr/local/bin/prepare-tokenizer-cache.py verify --component orchestrator

EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/health || exit 1

# --timeout-graceful-shutdown caps uvicorn's wait for in-flight connections to
# close on SIGTERM. Without it uvicorn waits indefinitely ("Waiting for
# connections to close"); with long-lived agent/SSE connections present, the
# lifespan shutdown — and with it the M1 leader-election advisory-unlock — never
# runs before the 60s SIGKILL, so leadership handoff takes the full grace period
# instead of a clean step-down. 10s leaves ample headroom under the 60s grace.
CMD ["uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "8085", "--timeout-graceful-shutdown", "10"]
