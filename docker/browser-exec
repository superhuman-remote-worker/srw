# Daemon: holds the persistent browser-use session
# ─────────────────────────────────────────────────────────────────────


def _parse_chromium_version(version_output: str) -> str | None:
    """Extract the dotted version from ``chromium --version`` output."""
    match = re.search(r"(\d+\.\d+\.\d+\.\d+)", version_output or "")
    return match.group(1) if match else None


_UA_CACHE: list = []  # memoized [ua_or_None]; the binary never changes mid-run


def _clean_user_agent() -> str | None:
    """Linux Chrome UA matching the real binary version, minus 'Headless'.

    Deriving the version from the actual binary keeps the UA consistent
    with what the browser otherwise reports; a mismatched hardcoded
    version would be a stronger bot signal than the one being removed.
    """
    if _UA_CACHE:
        return _UA_CACHE[0]
    user_agent = None
    try:
        result = subprocess.run(
            [CHROMIUM_PATH, "--version"],
            capture_output=True,
            text=True,
            timeout=15,
        )
        version = _parse_chromium_version(result.stdout)
        if version:
            user_agent = (
                "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                f"(KHTML, like Gecko) Chrome/{version} Safari/537.36"
            )
    except Exception as exc:
        log(f"user-agent probe failed: {exc}")
    _UA_CACHE.append(user_agent)
    return user_agent


_XVFB_PROC: list = []  # daemon-lifetime handle; started at most once


def _x_socket_ready(display: str) -> bool:
    """True once the X server's unix socket for ``display`` exists."""
    num = display.lstrip(":").split(".")[0]
    return Path(f"/tmp/.X11-unix/X{num}").exists()


async def _ensure_display() -> bool:
    """Bring up an Xvfb display for headful Chromium. False → stay headless.

    Idempotent and deliberately non-fatal. A workspace without Xvfb, or an Xvfb
    that refuses to start, degrades to the previous headless behaviour rather
    than breaking every ``browser_*`` tool — the same posture the daemon takes
    everywhere else. The cost of degrading is a browser that fails bot checks,
    not a browser that fails to run.
    """
    if not HEADFUL:
        return False
    if _XVFB_PROC:
        return _XVFB_PROC[0].poll() is None
    # An inherited display wins: a real X server, or an outer `xvfb-run` that
    # already wrapped us. Never start a second server over a working one.
    inherited = os.environ.get("DISPLAY")
    if inherited and _x_socket_ready(inherited):
        log(f"using inherited DISPLAY={inherited}")
        return True
    # Adopt an Xvfb already sitting on our display. A SIGKILLed daemon never
    # runs _stop_display, so its Xvfb outlives it; without this the replacement
    # daemon's spawn loses the address-in-use race and degrades to headless for
    # the rest of the workspace's life — a silent fingerprint regression whose
    # only symptom is bot checks starting to fail again.
    if _x_socket_ready(DISPLAY_NAME):
        os.environ["DISPLAY"] = DISPLAY_NAME
        log(f"adopting existing display {DISPLAY_NAME}")
        return True
    if shutil.which("Xvfb") is None:
        log("Xvfb not installed; falling back to headless")
        return False
    try:
        proc = subprocess.Popen(
            [
                "Xvfb",
                DISPLAY_NAME,
                "-screen",
                "0",
                f"{SCREEN_WIDTH}x{SCREEN_HEIGHT}x24",
                "-nolisten",
                "tcp",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as exc:
        log(f"Xvfb spawn failed ({exc}); falling back to headless")
        return False

    deadline = time.monotonic() + XVFB_START_TIMEOUT_S
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            log(f"Xvfb exited rc={proc.returncode}; falling back to headless")
            return False
        if _x_socket_ready(DISPLAY_NAME):
            os.environ["DISPLAY"] = DISPLAY_NAME
            _XVFB_PROC.append(proc)
            log(f"Xvfb up on {DISPLAY_NAME} ({SCREEN_WIDTH}x{SCREEN_HEIGHT})")
            return True
        await asyncio.sleep(0.1)

    log("Xvfb did not come up in time; falling back to headless")
    try:
        proc.terminate()
    except Exception:
        pass
    return False


def _stop_display() -> None:
    """Reap Xvfb on daemon shutdown so a restart gets a clean display."""
    while _XVFB_PROC:
        proc = _XVFB_PROC.pop()
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass


class BrowserDaemon:
    """Owns a single persistent ``BrowserSession`` and runs actions on it."""

    def __init__(self) -> None:
        self._session = None
        self._lock = asyncio.Lock()
        self._screencast_lock = asyncio.Lock()
        self._screencast = None
        self._focus_change_task = None
        self._focus_change_revision = 0
        self._focus_handler = None
        self._start_page_task = None
        self.should_exit = False
        self._files = LocalFileServer()
        self.hub = StreamHub()

    async def _get_session(self):
        """Return a healthy BrowserSession, (re)starting Chromium if needed."""
        from browser_use import BrowserSession

        if self._session is not None:
            try:
                await self._session.get_current_page_url()
                return self._session
            except Exception:
                log("session unhealthy, restarting")
                await self._close_session()

        Path(PROFILE_DIR).mkdir(parents=True, exist_ok=True)
        # browser-use launches Chromium from the explicit executable_path below
        # (the agent-chromium symlink → Playwright's Chromium). Pinning the binary
        # keeps browser-use off its auto-detect/auto-install path. No CDP port, no
        # remote debugging. The workspace pod can't run Chromium's sandbox (no user
        # namespaces), so disable it and avoid /dev/shm + GPU — the same flags the
        # old _start_remote_chromium used.
        #
        # Fingerprint hygiene. AutomationControlled clears navigator.webdriver;
        # the UA override keeps the real binary's version but drops any Headless
        # marker. The remaining signals — and they are the ones that actually
        # fail bot checks — are geometry coherence, WebGL presence and the
        # permission surface; see the HEADFUL block above for the measurements.
        headful = await _ensure_display()
        args = [
            "--no-sandbox",
            "--disable-dev-shm-usage",
            "--disable-blink-features=AutomationControlled",
        ]
        if headful:
            # Software GL, but *present*. Without a GPU this still reports
            # SwiftShader, which is a weak signal; having no WebGL context at
            # all is a strong one. --window-size sizes the real window, which
            # in turn sizes the viewport (no device-metrics override below).
            args += [
                "--use-gl=angle",
                "--use-angle=swiftshader",
                "--enable-unsafe-swiftshader",
                f"--window-size={SCREEN_WIDTH},{SCREEN_HEIGHT}",
                "--window-position=0,0",
            ]
        else:
            args.append("--disable-gpu")
        user_agent = _clean_user_agent()
        if user_agent:
            args.append(f"--user-agent={user_agent}")
        # Headful only: let the window drive the viewport instead of overriding
        # device metrics, so inner ≤ outer ≤ screen holds. Headless has no real
        # window, so it keeps browser-use's default sizing.
        sizing = (
            {
                "no_viewport": True,
                "viewport": None,
                "window_size": {"width": SCREEN_WIDTH, "height": SCREEN_HEIGHT},
            }
            if headful
            else {}
        )
        session = BrowserSession(
            headless=not headful,
            executable_path=CHROMIUM_PATH,
            user_data_dir=PROFILE_DIR,
            chromium_sandbox=False,
            # browser-use grants a permission set by default. A profile where
            # Notification.permission is already "granted" without anyone having
            # been prompted is a long-standing automation tell; real first-visit
            # state is "default".
            permissions=[],
            args=args,
            **sizing,
        )
        await session.start()
        self._session = session
        self._install_focus_handler(session)
        log(f"Chromium session started (headful={headful})")
        return session

    async def _open_start_page(self) -> None:
        """Navigate a still-blank cold-opened browser to the start page."""
        # Decide under the lock, load outside it. Holding the daemon-wide
        # lock across the load serialises every other action behind a page
        # nobody asked for — and the victim is ensure_screencast, which
        # is what SUBSCRIBES to the page events. Attaching late does not just
        # delay the stream, it loses information: a navigation that starts
        # before the screencast attaches never delivers its frameStartedLoading,
        # so the viewer sees a page change with no loading:true edge and
        # anything waiting on that transition waits forever.
        try:
            async with self._lock:
                session = await self._get_session()
                url = await session.get_current_page_url()
                if url and url != "about:blank":
                    return
            # Deliberately NOT wrapped in asyncio.wait_for. Cancelling a
            # navigate_to mid-flight does not abort the navigation, it
            # abandons a browser-use NavigateToUrlEvent inside its event bus:
            # the next navigation then queues behind the orphan until bubus
            # times it out 30s later, with duplicate CDP responses along the
            # way. A real navigation arriving while this one is still in
            # flight simply supersedes it, which is the desired outcome —
            # the start page only ever fires on an otherwise blank page.
            await session.navigate_to(STREAM_START_URL)
        except Exception as exc:
            log(f"start page navigation failed: {exc}")

    def _install_focus_handler(self, session) -> None:
        """Subscribe once; the event-bus callback itself never awaits locks."""
        from browser_use.browser.events import AgentFocusChangedEvent

        def on_agent_focus_changed(event) -> None:
            del event
            self._focus_change_revision += 1
            if (
                self._focus_change_task is None
                or self._focus_change_task.done()
            ):
                self._focus_change_task = asyncio.create_task(
                    self._follow_agent_focus()
                )

        session.event_bus.on(AgentFocusChangedEvent, on_agent_focus_changed)
        self._focus_handler = on_agent_focus_changed

    async def _follow_agent_focus(self) -> None:
        """Coalesce focus events and switch under screencast→action locks."""
        task = asyncio.current_task()
        try:
            while True:
                await asyncio.sleep(0)
                revision = self._focus_change_revision
                if not self.hub.viewers:
                    return
                async with self._screencast_lock:
                    if not self.hub.viewers:
                        return
                    async with self._lock:
                        session = self._session
                        if session is None:
                            return
                        target_id = session.agent_focus_target_id
                        if target_id is None:
                            return
                        if self._screencast is None:
                            self._screencast = ScreencastCdp(session, self.hub)
                        await self._screencast.start(target_id=target_id)
                if revision == self._focus_change_revision:
                    return
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            log(f"active-target screencast switch failed: {exc}")
        finally:
            if self._focus_change_task is task:
                self._focus_change_task = None

    async def _close_session(self) -> None:
        errors = []
        focus_task = self._focus_change_task
        if focus_task is not None and focus_task is not asyncio.current_task():
            focus_task.cancel()
            await asyncio.gather(focus_task, return_exceptions=True)
        self._focus_change_task = None
        self._focus_handler = None
        if self._screencast is not None:
            try:
                await self._screencast.stop()
            except Exception as exc:
                errors.append(exc)
            self._screencast = None
        if self._session is not None:
            try:
                await self._session.stop()
            except Exception as exc:
                errors.append(exc)
            self._session = None
        self.hub.clear_generation()
        self.hub.shutdown_viewers("browser_gone")
        if errors:
            raise RuntimeError(
                f"browser session shutdown failed ({len(errors)} error(s))"
            ) from errors[0]

    # ── action handlers (mirror browser_direct.py helpers) ──

    async def _page_state(self, session, args: dict) -> dict:
        # get_browser_state_summary builds the DOM, populates the selector map
        # (so get_element_by_index works for click/type/select), and captures a
        # screenshot — all in one call. (DomService.get_serialized_dom_tree does
        # NOT populate the session selector map, which breaks ref-based actions.)
        include_shot = bool(args.get("include_screenshot"))
        summary = await session.get_browser_state_summary(
            include_screenshot=include_shot
        )

        dom_text = summary.dom_state.llm_representation()
        max_chars = int(args.get("max_dom_chars", 40000))
        if len(dom_text) > max_chars:
            dom_text = dom_text[:max_chars] + "\n... (DOM truncated)"

        result: dict = {
            "url": summary.url,
            "title": await _document_title(session, summary.title),
            "dom": dom_text,
        }

        if include_shot and summary.screenshot:
            result["screenshot"] = summary.screenshot  # already base64

        try:
            tabs = summary.tabs
            if tabs and len(tabs) > 1:
                result["tabs"] = [
                    {
                        "id": getattr(t, "target_id", getattr(t, "id", None)),
                        "url": getattr(t, "url", None),
                        "title": getattr(t, "title", None),
                    }
                    for t in tabs
                ]
        except Exception:
            pass

        self.hub.update_page_state(
            url=result["url"],
            title=result["title"],
        )
        result["baton"] = self.hub.baton
        return result

    async def _click(self, session, ref: int) -> None:
        from browser_use.browser.events import ClickElementEvent

        node = await session.get_element_by_index(ref)
        if node is None:
            raise ValueError(
                f"Element ref={ref} not found. Use snapshot to get current refs."
            )
        opens_new_tab = (
            (getattr(node, "attributes", {}) or {}).get("target", "").lower()
            == "_blank"
        )
        existing_targets = (
            {tab.target_id for tab in await session.get_tabs()}
            if opens_new_tab
            else set()
        )
        event = session.event_bus.dispatch(ClickElementEvent(node=node))
        await event
        await event.event_result(raise_if_any=True)
        if opens_new_tab:
            await self._switch_to_new_click_target(session, existing_targets)

    async def _switch_to_new_click_target(self, session, existing_targets) -> None:
        """Make browser-use's newest `_blank` target the explicit agent focus."""
        from browser_use.browser.events import SwitchTabEvent

        new_target_id = None
        for _ in range(40):
            tabs = await session.get_tabs()
            new_targets = [
                tab.target_id
                for tab in tabs
                if tab.target_id not in existing_targets
            ]
            if new_targets:
                new_target_id = new_targets[-1]
                break
            await asyncio.sleep(0.05)
        if new_target_id is not None:
            switch = session.event_bus.dispatch(
                SwitchTabEvent(target_id=new_target_id)
            )
            await switch
            await switch.event_result(raise_if_any=True)

    async def _type(self, session, ref: int, text: str, clear: bool = True) -> None:
        from browser_use.browser.events import TypeTextEvent

        node = await session.get_element_by_index(ref)
        if node is None:
            raise ValueError(
                f"Element ref={ref} not found. Use snapshot to get current refs."
            )
        event = session.event_bus.dispatch(
            TypeTextEvent(node=node, text=text, clear=clear)
        )
        await event
        await event.event_result(raise_if_any=True)

    async def _select(self, session, ref: int, value: str) -> None:
        from browser_use.browser.events import SelectDropdownOptionEvent

        node = await session.get_element_by_index(ref)
        if node is None:
            raise ValueError(
                f"Element ref={ref} not found. Use snapshot to get current refs."
            )
        # browser-use's SelectDropdownOptionEvent selects by the option's visible
        # text; the field is ``text`` (not ``option``). Passing the wrong kwarg
        # trips a pydantic "text Field required" error and the select never runs.
        event = session.event_bus.dispatch(
            SelectDropdownOptionEvent(node=node, text=value)
        )
        await event
        await event.event_result(raise_if_any=True)

    async def _scroll(
        self, session, direction: str, amount: int = 500, ref=None
    ) -> None:
        from browser_use.browser.events import ScrollEvent

        node = None
        if ref is not None:
            node = await session.get_element_by_index(ref)
        event = session.event_bus.dispatch(
            ScrollEvent(direction=direction, amount=amount, node=node)
        )
        await event
        # ScrollEvent's handler returns None (EventResult[NoneType]); the default
        # raise_if_none=True would reject a perfectly good scroll with "Expected at
        # least one handler to return a non-None result". Keep raise_if_any so real
        # handler exceptions still surface.
        await event.event_result(raise_if_any=True, raise_if_none=False)

    async def _back(self, session) -> None:
        page = await session.get_current_page()
        if page is not None:
            await page.evaluate("() => { window.history.back(); }")
            await asyncio.sleep(0.5)

    # ── shared-browser streaming hooks ──

    async def ensure_screencast(self) -> None:
        """Start (or restart) the screencast while viewers exist."""
        if not self.hub.viewers:
            return
        async with self._screencast_lock:
            if not self.hub.viewers:
                return
            if (
                self._screencast is not None
                and self._screencast._running
            ):
                return
            async with self._lock:
                session = await self._get_session()
            if self._screencast is None:
                self._screencast = ScreencastCdp(session, self.hub)
            await self._screencast.start(
                target_id=session.agent_focus_target_id
            )

    async def stop_screencast(self) -> None:
        async with self._screencast_lock:
            if self.hub.viewers:
                return
            screencast = self._screencast
            if screencast is not None:
                await screencast.stop()

    async def dispatch_user_input(self, event: dict) -> None:
        async with self._lock:
            if self.hub.baton != "user":
                return
            screencast = self._screencast
            if screencast is not None and screencast._running:
                await screencast.dispatch_input(event)

    async def take_user_baton(self) -> None:
        """Transfer control only after any in-flight agent action finishes."""
        async with self._lock:
            self.hub.take_baton()

    async def release_user_baton(self) -> None:
        """Finish any in-flight user mutation before returning control."""
        async with self._lock:
            self.hub.release_baton()

    async def user_control_nav(self, op: str, url=None) -> None:
        """Run one viewer navigation mutation under the daemon action lock."""
        if self.hub.baton != "user":
            return
        async with self._lock:
            if self.hub.baton != "user":
                return
            session = await self._get_session()
            if op == "navigate":
                await session.navigate_to(
                    validate_user_nav(url or "", self._files)
                )
            elif op == "back":
                await self._back(session)
            elif op == "reload":
                page = await session.get_current_page()
                if page is not None:
                    await page.evaluate("() => { location.reload(); }")
            try:
                self.hub.update_page_state(
                    url=await session.get_current_page_url(),
                    title=await _document_title(
                        session, await session.get_current_page_title()
                    ),
                )
            except Exception:
                pass

    def _user_driving_refusal(self) -> dict:
        return {
            "error": "user_is_driving",
            "url": self.hub.state_extra.get("url"),
            "message": (
                "The user is currently driving the shared browser. "
                "Read-only actions (snapshot, screenshot) still work; "
                "ask the user to release control before taking actions."
            ),
        }

    async def handle(self, req: dict) -> dict:
        """Dispatch one request to the live session. Always returns a dict."""
        action = req.get("action")
        args = req.get("args") or {}

        if action not in VALID_ACTIONS:
            return {"error": f"unknown action: {action!r}"}
        if self.should_exit and action != "shutdown":
            return {"error": "browser daemon is shutting down"}

        # While the user drives, refuse mutating agent actions up front:
        # never spawn Chromium and never take the action lock.
        if action in MUTATING_ACTIONS and self.hub.baton == "user":
            return self._user_driving_refusal()

        # Serialize: browser-use sessions are not concurrency-safe, and the
        # agent issues actions one at a time anyway.
        async with self._lock:
            try:
                # A viewer may have requested the baton while this action was
                # waiting for the lock. Recheck at the serialization boundary.
                if action in MUTATING_ACTIONS and self.hub.baton == "user":
                    return self._user_driving_refusal()

                if action == "shutdown":
                    cleanup_error = None
                    try:
                        await self._close_session()
                    except Exception as exc:
                        cleanup_error = exc
                    try:
                        self._files.close()
                    except Exception as exc:
                        cleanup_error = cleanup_error or exc
                    # Always retire the daemon after a shutdown request. The
                    # client performs an exact /proc + socket postcondition and
                    # can TERM/KILL any exact-profile orphan if graceful
                    # browser-use cleanup failed.
                    self.should_exit = True
                    if cleanup_error is not None:
                        return {"error": "browser shutdown required forced cleanup"}
                    return {"ok": True, "pid": os.getpid()}

                session = await self._get_session()

                if action == "stream_info":
                    if self.hub.generation is None:
                        self.hub.mint_generation(args.get("initial_baton"))
                        # Cold open: land on the start page in the background
                        # so this response isn't held behind a page load.
                        # Backgrounding alone does NOT free the viewer path —
                        # the task holds the daemon-wide lock while it loads,
                        # so anything that takes that lock (ensure_screencast,
                        # user navigation) waits behind it. What keeps a slow
                        # start page from stranding viewers is that viewer
                        # STATE is delivered without ever taking that lock.
                        # Lifecycle bootstrap, not agent driving —
                        # deliberately outside the baton check.
                        self._start_page_task = asyncio.create_task(
                            self._open_start_page()
                        )
                    return {
                        "generation": self.hub.generation,
                        "token": self.hub.token,
                        "port": STREAM_PORT,
                        "baton": self.hub.baton,
                    }
                if action == "navigate":
                    # file:// is blocked outright by browser-use's watchdog, so a
                    # local path is rendered through a loopback HTTP listener
                    # rooted at the workspace. Non-file URLs pass through
                    # untouched. See LocalFileServer.
                    await session.navigate_to(self._files.url_for(args["url"]))
                    return await self._page_state(session, args)
                if action == "snapshot":
                    return await self._page_state(session, args)
                if action == "screenshot":
                    shot = await session.take_screenshot()
                    url = await session.get_current_page_url()
                    title = await _document_title(
                        session, await session.get_current_page_title()
                    )
                    self.hub.update_page_state(url=url, title=title)
                    return {
                        "url": url,
                        "title": title,
                        "screenshot": base64.b64encode(shot).decode(),
                        "baton": self.hub.baton,
                    }
                if action == "click":
                    await self._click(session, int(args["ref"]))
                    return await self._page_state(session, args)
                if action == "type":
                    await self._type(
                        session,
                        int(args["ref"]),
                        args.get("text", ""),
                        clear=bool(args.get("clear", True)),
                    )
                    return await self._page_state(session, args)
                if action == "select":
                    await self._select(session, int(args["ref"]), args["value"])
                    return await self._page_state(session, args)
                if action == "scroll":
                    ref = args.get("ref")
                    await self._scroll(
                        session,
                        args.get("direction", "down"),
                        int(args.get("amount", 500)),
                        int(ref) if ref is not None else None,
                    )
                    return await self._page_state(session, args)
                if action == "back":
                    await self._back(session)
                    return await self._page_state(session, args)
            except KeyError as e:
                return {"error": f"{action}: missing required argument {e}"}
            except Exception as e:
                return {"error": f"{action} failed: {e}"}

        return {"error": f"unhandled action: {action}"}


# ─────────────────────────────────────────────────────────────────────
# Stream server (loopback TCP side-channel for the shared browser)
# ─────────────────────────────────────────────────────────────────────


async def _send_stream_error(writer, code: str, message: str) -> None:
    try:
        writer.write(
            encode_stream_frame(
                T_ERROR,
                json.dumps({"code": code, "message": message}).encode(),
            )
        )
        await writer.drain()
    except Exception:
        pass


async def _handle_stream_conn(daemon, reader, writer) -> None:
    hub = daemon.hub
    try:
        frame_type, payload = await asyncio.wait_for(
            read_stream_frame(reader), timeout=5.0
        )
        hello = json.loads(payload.decode()) if frame_type == T_HELLO else {}
    except Exception:
        writer.close()
        return

    if not hub.token or hello.get("token") != hub.token:
        await _send_stream_error(
            writer,
            "unauthorized",
            "invalid stream hello token",
        )
        writer.close()
        return

    max_viewers = hello.get("max_viewers")
    if (
        isinstance(max_viewers, bool)
        or not isinstance(max_viewers, int)
        or not 1 <= max_viewers <= 16
    ):
        await _send_stream_error(
            writer,
            "invalid_hello",
            "max_viewers must be an integer within [1, 16]",
        )
        writer.close()
        return

    queue = ViewerQueue(maxsize=4)
    viewer_id = hub.add_viewer(queue, max_viewers)
    if viewer_id is None:
        await _send_stream_error(
            writer,
            "viewer_limit",
            "shared browser viewer limit reached",
        )
        writer.close()
        return
    tasks = []
    log(
        f"stream viewer {viewer_id} connected "
        f"({len(hub.viewers)} total)"
    )
    try:
        queue.put_nowait(
            encode_stream_frame(
                T_STATE, json.dumps(hub.state_payload()).encode()
            )
        )

        async def pump_out():
            while True:
                frame = await queue.get()
                if frame is None:
                    break
                writer.write(frame)
                await writer.drain()

        async def pump_in():
            while True:
                frame_type, payload = await read_stream_frame(reader)
                if frame_type not in (T_INPUT, T_CONTROL):
                    continue
                message = json.loads(payload.decode())
                if frame_type == T_INPUT:
                    if hub.baton == "user":
                        await daemon.dispatch_user_input(message)
                    continue

                op = message.get("op")
                if op == "take_baton":
                    await daemon.take_user_baton()
                elif op == "release_baton":
                    await daemon.release_user_baton()
                elif op in ("navigate", "back", "reload"):
                    try:
                        await daemon.user_control_nav(
                            op, message.get("url")
                        )
                    except ValueError as exc:
                        _queue_stream_frame(
                            queue,
                            encode_stream_frame(
                                T_ERROR,
                                json.dumps(
                                    {
                                        "code": "navigation_rejected",
                                        "message": str(exc),
                                    }
                                ).encode(),
                            ),
                        )

        # Pumps first, THEN the screencast. The STATE above is already
        # queued, and pump_out is the only thing that can put it on the
        # wire — starting the screencast first makes a viewer's whole
        # handshake hostage to daemon work it does not depend on. That is
        # not hypothetical: ensure_screencast waits on the daemon-wide
        # lock, so a cold-open start-page navigation holding that lock
        # left viewers with no STATE until the page finished loading.
        tasks = [
            asyncio.create_task(pump_out()),
            asyncio.create_task(pump_in()),
        ]
        await daemon.ensure_screencast()
        done, _ = await asyncio.wait(
            tasks, return_when=asyncio.FIRST_COMPLETED
        )
        for task in done:
            try:
                task.result()
            except (asyncio.CancelledError, asyncio.IncompleteReadError):
                pass
            except Exception as exc:
                log(f"stream viewer {viewer_id} pump ended: {exc}")
    except Exception as exc:
        log(f"stream viewer {viewer_id} setup ended: {exc}")
    finally:
        for task in tasks:
            task.cancel()
        if tasks:
            await asyncio.gather(*tasks, return_exceptions=True)
        hub.remove_viewer(viewer_id)
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass
        log(
            f"stream viewer {viewer_id} disconnected "
            f"({len(hub.viewers)} total)"
        )
        if not hub.viewers:
            await daemon.stop_screencast()


async def start_stream_server(daemon):
    """Bind the loopback-only listener and wire STATE broadcasting."""

    def broadcast_state():
        daemon.hub.broadcast(
            encode_stream_frame(
                T_STATE, json.dumps(daemon.hub.state_payload()).encode()
            )
        )

    daemon.hub.on_state_change = broadcast_state
    server = await asyncio.start_server(
        lambda reader, writer: _handle_stream_conn(
            daemon, reader, writer
        ),
        "127.0.0.1",
        STREAM_PORT,
    )
    log(f"stream listener on 127.0.0.1:{STREAM_PORT}")
    return server


# ─────────────────────────────────────────────────────────────────────
# Daemon server (unix socket, newline-delimited JSON: one req/resp per conn)
# ─────────────────────────────────────────────────────────────────────


async def _serve() -> int:
    daemon = BrowserDaemon()

    async def on_conn(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
        try:
            line = await reader.readline()
            if not line:
                return
            req = json.loads(line.decode())
            resp = await daemon.handle(req)
            writer.write(json.dumps(resp).encode() + b"\n")
            await writer.drain()
        except Exception as e:
            try:
                writer.write(json.dumps({"error": f"daemon error: {e}"}).encode() + b"\n")
                await writer.drain()
            except Exception:
                pass
        finally:
            try:
                writer.close()
            except Exception:
                pass
            if daemon.should_exit:
                # graceful shutdown after responding to a 'shutdown' request
                asyncio.get_event_loop().call_soon(_stop_server)

    stop_event = asyncio.Event()

    def _stop_server():
        stop_event.set()

    # Stale socket cleanup; bail out if another daemon already owns it.
    if os.path.exists(SOCKET_PATH):
        if _ping(SOCKET_PATH):
            log("another daemon is already running; exiting")
            return 0
        try:
            os.unlink(SOCKET_PATH)
        except OSError:
            pass

    server = await asyncio.start_unix_server(on_conn, path=SOCKET_PATH)
    try:
        os.chmod(SOCKET_PATH, 0o600)
    except OSError:
        pass
    try:
        stream_server = await start_stream_server(daemon)
    except Exception:
        server.close()
        await server.wait_closed()
        raise
    log(f"listening on {SOCKET_PATH}")
    try:
        async with server:
            await stop_event.wait()
    finally:
        stream_server.close()
        await stream_server.wait_closed()
        _stop_display()
    log("shutting down")
    try:
        os.unlink(SOCKET_PATH)
    except OSError:
        pass
    return 0


def _ping(path: str) -> bool:
    """True if a daemon is accepting connections on the socket."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1.0)
            s.connect(path)
        return True
    except OSError:
        return False


def _proc_cmdline(pid: int) -> list[str]:
    """Read one process argv without trusting a writable pid marker."""
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (OSError, ValueError):
        return []
    return [
        part.decode(errors="surrogateescape")
        for part in raw.split(b"\0")
        if part
    ]


def _browser_resident_pids() -> dict[int, str]:
    """Return exact browser-exec/Chromium residents owned by this profile.

    Local file servers are threads inside the browser-exec daemon, so proving
    the daemon absent proves those listeners absent too. Xvfb is deliberately
    not included: it owns only a display socket below ``/tmp`` and cannot write
    the durable profile/workspace paths. A daemon-spawned Xvfb is reaped by
    ``_stop_display`` during the graceful path.
    """
    residents = {}
    if not _proc_cmdline(os.getpid()):
        return {-1: "proc scan unavailable"}
    script = str(Path(__file__).resolve())
    profile_flag = f"--user-data-dir={PROFILE_DIR}"
    try:
        proc_entries = Path("/proc").iterdir()
    except OSError:
        return residents
    for entry in proc_entries:
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid == os.getpid():
            continue
        args = _proc_cmdline(pid)
        if not args:
            continue
        is_daemon = (
            len(args) >= 3
            and os.path.realpath(args[1]) == script
            and args[2] == "serve"
        )
        has_profile = profile_flag in args or any(
            arg == "--user-data-dir"
            and index + 1 < len(args)
            and args[index + 1] == PROFILE_DIR
            for index, arg in enumerate(args)
        )
        if is_daemon:
            residents[pid] = "browser-exec"
        elif has_profile:
            residents[pid] = "chromium-profile"
    return residents


def _wait_for_browser_shutdown(timeout: float) -> dict[int, str]:
    deadline = time.monotonic() + timeout
    while True:
        residents = _browser_resident_pids()
        accepting = _ping(SOCKET_PATH)
        if not residents and not accepting:
            return {}
        if time.monotonic() >= deadline:
            return residents or {-1: "browser-exec socket still accepting"}
        time.sleep(0.1)


def _signal_browser_residents(residents: dict[int, str], sig: int) -> None:
    for pid in residents:
        if pid <= 0:
            continue
        try:
            os.kill(pid, sig)
        except (OSError, ValueError):
            pass


def _complete_shutdown() -> dict:
    """Gracefully wait, then stop exact residual processes and prove absence."""
    import signal

    was_running = bool(_browser_resident_pids()) or _ping(SOCKET_PATH)
    remaining = _wait_for_browser_shutdown(10.0)
    forced = bool(remaining)
    if remaining:
        _signal_browser_residents(remaining, signal.SIGTERM)
        remaining = _wait_for_browser_shutdown(3.0)
    if remaining:
        _signal_browser_residents(remaining, signal.SIGKILL)
        remaining = _wait_for_browser_shutdown(2.0)
    if remaining or _ping(SOCKET_PATH):
        kinds = sorted(set(remaining.values()))
        return {
            "error": "browser residents did not stop",
            "remaining": kinds,
        }
    # The server normally unlinks this itself. Remove only a non-accepting
    # stale socket after process absence has been established.
    try:
        os.unlink(SOCKET_PATH)
    except FileNotFoundError:
        pass
    except OSError:
        return {"error": "browser socket cleanup was not acknowledged"}
    return {
        "ok": True,
        "shutdown_complete": True,
        "already_stopped": not was_running,
        "forced": forced,
    }


# ─────────────────────────────────────────────────────────────────────
# Client
# ─────────────────────────────────────────────────────────────────────


def _spawn_daemon() -> None:
    """Start the daemon detached, logging to DAEMON_LOG."""
    Path(DAEMON_LOG).parent.mkdir(parents=True, exist_ok=True)
    log_fh = open(DAEMON_LOG, "a")
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "serve"],
        stdout=log_fh,
        stderr=log_fh,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )


def _request(req: bytes, timeout: float) -> bytes:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(SOCKET_PATH)
        s.sendall(req)
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return buf


def run_client(action: str, args: dict, timeout: float) -> int:
    """Send one action; print the JSON reply to stdout. Returns exit code."""
    if action == "type" and "env_var" in args:
        name = args["env_var"]
        if "text" in args or not isinstance(name, str) or not name:
            print(
                json.dumps(
                    {"error": "Supply exactly one of text or a nonempty env_var"}
                )
            )
            return 1
        value = os.environ.get(name)
        if value is None:
            print(
                json.dumps(
                    {"error": f"Workspace environment variable {name} is not set"}
                )
            )
            return 1
        args = {key: value for key, value in args.items() if key != "env_var"}
        args["text"] = value
    req = json.dumps({"action": action, "args": args}).encode() + b"\n"

    # Shutdown is idempotent and must never cold-start the daemon it is trying
    # to retire. It also cleans up an exact-profile Chromium orphan left by a
    # previously killed daemon.
    if action == "shutdown" and not _ping(SOCKET_PATH):
        result = _complete_shutdown()
        print(json.dumps(result))
        return 0 if result.get("ok") is True else 1

    last_err = None
    for attempt in range(12):  # ~ up to 6s of daemon spin-up
        try:
            resp = _request(req, timeout)
            if action == "shutdown":
                # The daemon replies before its server finally block closes
                # sockets and reaps the display. Do not expose that early reply
                # as terminal acknowledgement; return only the physical proof.
                result = _complete_shutdown()
                print(json.dumps(result))
                return 0 if result.get("ok") is True else 1
            sys.stdout.write(resp.decode().rstrip("\n") + "\n")
            return 0
        except (ConnectionRefusedError, FileNotFoundError, OSError) as e:
            last_err = e
            if action == "shutdown":
                result = _complete_shutdown()
                print(json.dumps(result))
                return 0 if result.get("ok") is True else 1
            if attempt == 0:
                log("daemon not running, spawning")
                _spawn_daemon()
            import time

            time.sleep(0.5)

    print(json.dumps({"error": f"could not reach browser-exec daemon: {last_err}"}))
    return 1


# ─────────────────────────────────────────────────────────────────────
# Entrypoint
# ─────────────────────────────────────────────────────────────────────


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="browser-exec")
    parser.add_argument("action", help="serve | " + " | ".join(sorted(VALID_ACTIONS)))
    parser.add_argument("--json", default="{}", help="JSON-encoded action arguments")
    parser.add_argument(
        "--timeout", type=float, default=180.0, help="client socket timeout (s)"
    )
    ns = parser.parse_args(argv)

    if ns.action == "serve":
        try:
            return asyncio.run(_serve())
        except KeyboardInterrupt:
            return 0

    try:
        args = json.loads(ns.json)
        if not isinstance(args, dict):
            raise ValueError("--json must encode an object")
    except ValueError as e:
        print(json.dumps({"error": f"bad --json: {e}"}))
        return 1

    return run_client(ns.action, args, ns.timeout)


if __name__ == "__main__":
    sys.exit(main())
