DOCUMENT_TITLE_TIMEOUT = 2.0
_document_title_error_logged = False


async def _read_document_title(session):
    # focus=False: reading a title must not change or touch agent focus (and
    # skips the extra runIfWaitingForDebugger round trip).
    cdp = await session.get_or_create_cdp_session(
        target_id=session.agent_focus_target_id, focus=False
    )
    return await cdp.cdp_client.send.Runtime.evaluate(
        params={"expression": "document.title", "returnByValue": True},
        session_id=cdp.session_id,
    )


async def _document_title(session, fallback):
    """Return the live ``document.title``, or ``fallback``.

    browser_use's ``get_current_page_title()`` returns the CDP target's cached
    ``TargetInfo.title``. Chrome reports a page that has no title yet under its
    formatted URL (the hostname), so a snapshot taken before
    ``targetInfoChanged`` arrives reports "example.com" instead of "Example
    Domain". Reading ``document.title`` from the page avoids the race. Any
    failure, timeout, or an empty title returns ``fallback``: a title read must
    never fail or stall a browser action. The whole read (session lookup plus
    evaluate) shares one DOCUMENT_TITLE_TIMEOUT bound.
    """
    global _document_title_error_logged
    try:
        result = await asyncio.wait_for(
            _read_document_title(session), DOCUMENT_TITLE_TIMEOUT
        )
        value = ((result or {}).get("result") or {}).get("value")
        if isinstance(value, str) and value.strip():
            return value
    except (Exception, asyncio.TimeoutError) as exc:
        if not _document_title_error_logged:
            _document_title_error_logged = True
            log(f"document.title read failed ({type(exc).__name__}); using cached title")
    return fallback


def _queue_stream_frame(queue, frame) -> None:
    """Enqueue one outbound frame, dropping the oldest item if necessary."""
    if queue.full():
        try:
            queue.get_nowait()
        except asyncio.QueueEmpty:
            pass
    try:
        queue.put_nowait(frame)
    except asyncio.QueueFull:
        pass


class ViewerQueue(asyncio.Queue):
    """Bounded per-viewer queue where screencast frames supersede in place.

    A viewer only ever wants the newest frame: replacing a queued unsent
    FRAME caps stale-frame latency at one frame no matter how far the
    viewer's TCP/WS path falls behind, while STATE/ERROR messages keep
    their bounded FIFO ordering. Reaches into asyncio.Queue's backing
    deque — our own subclass, single consumer, event-loop thread only.
    """

    def put_frame(self, frame: bytes) -> None:
        buffer = self._queue
        for index in range(len(buffer) - 1, -1, -1):
            item = buffer[index]
            if item is not None and len(item) > 4 and item[4] == T_FRAME:
                buffer[index] = frame
                return
        _queue_stream_frame(self, frame)


class StreamHub:
    """Shared-browser stream state: viewers, baton, browser generation.

    Owned by the daemon; the single authority for who is driving. See
    knowledge-base/knowledge/features/shared_browser.md (Piece 1).
    """

    def __init__(self) -> None:
        self.baton = "agent"
        self.generation = None
        self.token = None
        self.viewers: dict = {}
        self.viewer_limit = None
        self._next_viewer_id = 0
        self._auto_release = None
        self.state_extra = {"url": None, "title": None, "loading": False}
        self.viewport = {
            "width": STREAM_MAX_WIDTH,
            "height": STREAM_MAX_HEIGHT,
        }
        self.on_state_change = None

    def mint_generation(self, initial_baton=None) -> None:
        """Mint a new browser identity and hello token."""
        self.generation = str(uuid.uuid4())
        self.token = secrets.token_hex(32)
        if initial_baton in ("agent", "user"):
            self.baton = initial_baton

    def clear_generation(self) -> None:
        self.generation = None
        self.token = None

    def state_payload(self) -> dict:
        return {
            "generation": self.generation,
            "baton": self.baton,
            "viewport": self.viewport,
            **self.state_extra,
        }

    def update_page_state(
        self,
        *,
        url=None,
        title=None,
        loading=None,
    ) -> None:
        """Update observable page fields and broadcast only real changes."""
        changed = False
        for key, value in (
            ("url", url),
            ("title", title),
            ("loading", loading),
        ):
            if value is not None and self.state_extra.get(key) != value:
                self.state_extra[key] = value
                changed = True
        if changed:
            self._notify()

    def take_baton(self) -> None:
        self._set_baton("user")

    def release_baton(self) -> None:
        self._set_baton("agent")

    def _set_baton(self, holder: str) -> None:
        if self.baton != holder:
            self.baton = holder
            self._notify()

    def _notify(self) -> None:
        if self.on_state_change is not None:
            self.on_state_change()

    def add_viewer(self, queue, max_viewers: int):
        """Atomically apply the daemon-wide cap and reserve a viewer slot."""
        if not self.viewers or self.viewer_limit is None:
            effective_limit = max_viewers
        else:
            effective_limit = min(self.viewer_limit, max_viewers)
        self.viewer_limit = effective_limit
        if len(self.viewers) >= effective_limit:
            return None
        if self._auto_release is not None:
            self._auto_release.cancel()
            self._auto_release = None
        viewer_id = self._next_viewer_id
        self._next_viewer_id += 1
        self.viewers[viewer_id] = queue
        return viewer_id

    def remove_viewer(self, viewer_id) -> None:
        self.viewers.pop(viewer_id, None)
        if not self.viewers:
            self.viewer_limit = None
        if not self.viewers and self.baton == "user":
            loop = asyncio.get_running_loop()
            self._auto_release = loop.call_later(
                BATON_GRACE_S, self._release_after_grace
            )

    def _release_after_grace(self) -> None:
        self._auto_release = None
        self.release_baton()

    def broadcast(self, frame: bytes) -> None:
        """Fan an ordered message to viewers; drop oldest for laggards."""
        for queue in self.viewers.values():
            _queue_stream_frame(queue, frame)

    def broadcast_frame(self, frame: bytes) -> None:
        """Fan a screencast frame; a queued unsent frame is superseded."""
        for queue in self.viewers.values():
            put_frame = getattr(queue, "put_frame", None)
            if put_frame is not None:
                put_frame(frame)
            else:
                _queue_stream_frame(queue, frame)

    def shutdown_viewers(self, code: str) -> None:
        """Tell every viewer the browser is gone and stop its writer."""
        error_frame = encode_stream_frame(
            T_ERROR,
            json.dumps({"code": code, "message": "browser ended"}).encode(),
        )
        for queue in list(self.viewers.values()):
            # Viewer queues are bounded. Reserve room for both the terminal
            # ERROR and the close sentinel instead of risking a full queue
            # swallowing the sentinel.
            while queue.maxsize > 0 and queue.qsize() > queue.maxsize - 2:
                try:
                    queue.get_nowait()
                except asyncio.QueueEmpty:
                    break
            try:
                queue.put_nowait(error_frame)
                queue.put_nowait(None)
            except asyncio.QueueFull:
                # The stream server uses maxsize=4, but keep shutdown safe for
                # any smaller custom queue by prioritising the close sentinel.
                try:
                    queue.get_nowait()
                except asyncio.QueueEmpty:
                    pass
                try:
                    queue.put_nowait(None)
                except asyncio.QueueFull:
                    pass


class ScreencastCdp:
    """In-process CDP adapter for screencast frames and viewer input.

    Uses browser-use's own attached CDP client; no debugging port and no
    second connection. The call forms were verified in
    knowledge-base/knowledge/superpowers/plans/notes-browseruse-cdp-api.md.
    """

    def __init__(self, session, hub) -> None:
        self._session = session
        self._hub = hub
        self._cdp = None
        self._main_frame_id = None
        self._registered_clients = {}
        self._session_clients = {}
        self._running = False

    def _is_current_event(self, event_session_id) -> bool:
        return (
            self._cdp is not None
            and (
                event_session_id is None
                or event_session_id == self._cdp.session_id
            )
        )

    def _register_client(self, client) -> None:
        """Register this adapter's callbacks once per CDP client wrapper."""
        identity = id(client)
        if identity in self._registered_clients:
            return
        client.register.Page.screencastFrame(self._on_frame_event)
        client.register.Page.frameNavigated(self._on_navigated_event)
        client.register.Page.frameStartedLoading(
            self._on_frame_started_loading_event
        )
        client.register.Page.frameStoppedLoading(
            self._on_frame_stopped_loading_event
        )
        self._registered_clients[identity] = client

    async def start(self, target_id=None) -> None:
        """Start or move the screencast to the latest focused target."""
        requested_target = target_id or self._session.agent_focus_target_id
        if (
            self._running
            and self._cdp is not None
            and self._cdp.target_id == requested_target
        ):
            return
        if self._running:
            await self.stop()

        cdp = await self._session.get_or_create_cdp_session(
            target_id=requested_target
        )
        client = cdp.cdp_client

        # Resolve the main frame BEFORE publishing this session as current.
        # _register_client subscribes once per client, so when the screencast
        # moves to a target that reuses an already-registered client, the
        # handlers are live the moment _cdp is set — and every one of them
        # gates on _main_frame_id. Publishing _cdp first and resolving the
        # frame id a couple of awaits later opened a window where
        # frameStartedLoading was discarded as "not the main frame", so the
        # viewer silently lost the loading:true edge for that navigation and
        # anything waiting on the transition waited forever.
        main_frame = None
        try:
            frame_tree = await client.send.Page.getFrameTree(
                session_id=cdp.session_id
            )
            main_frame = (frame_tree.get("frameTree") or {}).get("frame") or {}
        except Exception:
            pass

        # No await between these two: the pair must land atomically for the
        # handlers, which read them together.
        self._cdp = cdp
        self._main_frame_id = (main_frame or {}).get("id")
        self._register_client(client)
        self._session_clients[cdp.session_id] = client
        if main_frame is not None:
            self._hub.update_page_state(
                url=main_frame.get("url"),
                loading=False,
            )

        try:
            metrics = await client.send.Page.getLayoutMetrics(
                session_id=cdp.session_id
            )
            css_viewport = (
                metrics.get("cssVisualViewport")
                or metrics.get("cssLayoutViewport")
                or {}
            )
            self._hub.viewport = {
                "width": int(css_viewport.get("clientWidth", STREAM_MAX_WIDTH)),
                "height": int(css_viewport.get("clientHeight", STREAM_MAX_HEIGHT)),
            }
        except Exception:
            pass
        try:
            self._hub.update_page_state(
                url=await self._session.get_current_page_url(),
                title=await _document_title(
                    self._session, await self._session.get_current_page_title()
                ),
                loading=False,
            )
        except Exception:
            pass

        # Mark running before the command can yield an initial event. Otherwise
        # that first frame can be dropped without an ACK and stall CDP.
        self._running = True
        try:
            await client.send.Page.startScreencast(
                params={
                    "format": "jpeg",
                    "quality": STREAM_QUALITY,
                    "maxWidth": STREAM_MAX_WIDTH,
                    "maxHeight": STREAM_MAX_HEIGHT,
                    "everyNthFrame": STREAM_EVERY_NTH,
                },
                session_id=cdp.session_id,
            )
        except Exception:
            self._running = False
            raise
        self._hub._notify()
        log("screencast started")

    def _on_frame_event(self, params, session_id=None) -> None:
        asyncio.create_task(self._handle_frame(params, session_id))

    async def _handle_frame(self, params, event_session_id=None) -> None:
        current_cdp = self._cdp
        ack_session_id = event_session_id or (
            current_cdp.session_id if current_cdp is not None else None
        )
        ack_client = self._session_clients.get(event_session_id)
        if ack_client is None and current_cdp is not None:
            ack_client = current_cdp.cdp_client
        try:
            if not self._is_current_event(event_session_id) or not self._running:
                return
            jpeg = base64.b64decode(params["data"])
            metadata = params.get("metadata") or {}
            header = {
                "generation": self._hub.generation,
                "w": metadata.get("deviceWidth"),
                "h": metadata.get("deviceHeight"),
                "ts": time.time(),
            }
            self._hub.broadcast_frame(
                encode_stream_frame(
                    T_FRAME, encode_frame_payload(header, jpeg)
                )
            )
        finally:
            # ACK after hand-off to the bounded viewer queues. This preserves
            # CDP source backpressure while slow viewers drop old frames.
            try:
                if ack_client is not None and ack_session_id is not None:
                    await ack_client.send.Page.screencastFrameAck(
                        params={"sessionId": params["sessionId"]},
                        session_id=ack_session_id,
                    )
            except Exception:
                pass

    def _on_navigated_event(self, params, session_id=None) -> None:
        if not self._is_current_event(session_id):
            return
        frame = params.get("frame") or {}
        if frame.get("parentId"):
            return
        self._main_frame_id = frame.get("id")
        self._hub.update_page_state(url=frame.get("url"))

    def _on_frame_started_loading_event(self, params, session_id=None) -> None:
        if not self._is_current_event(session_id):
            return
        if params.get("frameId") != self._main_frame_id:
            return
        self._hub.update_page_state(loading=True)

    def _on_frame_stopped_loading_event(self, params, session_id=None) -> None:
        if not self._is_current_event(session_id):
            return
        if params.get("frameId") != self._main_frame_id:
            return
        self._hub.update_page_state(loading=False)
        asyncio.create_task(self._refresh_page_state(session_id))

    async def _refresh_page_state(self, expected_session_id) -> None:
        if not self._is_current_event(expected_session_id):
            return
        try:
            url = await self._session.get_current_page_url()
            title = await _document_title(
                self._session, await self._session.get_current_page_title()
            )
        except Exception:
            return
        if not self._is_current_event(expected_session_id):
            return
        self._hub.update_page_state(url=url, title=title)

    async def dispatch_input(self, event: dict) -> None:
        if self._cdp is None:
            return
        client = self._cdp.cdp_client
        session_id = self._cdp.session_id
        kind = event.get("kind")
        params = event.get("params") or {}
        if kind == "mouse":
            await client.send.Input.dispatchMouseEvent(
                params=params, session_id=session_id
            )
        elif kind == "key":
            await client.send.Input.dispatchKeyEvent(
                params=params, session_id=session_id
            )
        elif kind == "insertText":
            # Viewer clipboard paste. The cockpit caps the text client-side;
            # this cap is defense in depth against a hand-rolled client.
            text = str(params.get("text", ""))[:INSERT_TEXT_MAX_CHARS]
            if text:
                await client.send.Input.insertText(
                    params={"text": text}, session_id=session_id
                )
        elif kind == "wheel":
            await client.send.Input.dispatchMouseEvent(
                params={**params, "type": "mouseWheel"},
                session_id=session_id,
            )

    async def stop(self) -> None:
        was_running = self._running
        self._running = False
        if self._cdp is not None and was_running:
            try:
                await self._cdp.cdp_client.send.Page.stopScreencast(
                    session_id=self._cdp.session_id
                )
            except Exception:
                pass
        log("screencast stopped")


def log(msg: str) -> None:
    """Diagnostics to stderr (never stdout — stdout is the JSON channel)."""
    print(f"[browser-exec] {msg}", file=sys.stderr, flush=True)


# ─────────────────────────────────────────────────────────────────────
# Local file rendering (file:// → loopback HTTP)
# ─────────────────────────────────────────────────────────────────────


class _QuietHandler(SimpleHTTPRequestHandler):
    """SimpleHTTPRequestHandler that logs through ``log`` (stderr, prefixed).

    The default handler writes access lines straight to stderr unprefixed. Route
    them through ``log`` instead so the daemon log stays greppable — the fetches
    a page makes (missing CSS, 404 assets) are the first thing you want when a
    mockup renders unstyled.
    """

    def log_message(self, fmt: str, *args) -> None:  # noqa: A003
        log("http " + (fmt % args))


class LocalFileServer:
    """Serves local files to the browser over a loopback HTTP listener.

    Why this exists: browser-use's security watchdog rejects any URL without a
    hostname *before* it consults ``allowed_domains``::

        # browser_use/browser/watchdogs/security_watchdog.py
        if parsed.scheme in ['data', 'blob']:
            return True
        host = parsed.hostname
        if not host:
            return False          # ← file:///... lands here, unconditionally

    So ``file://`` is refused on every workspace backend and no setting turns it
    off. Since every mockup an agent writes is a local file, the practical effect
    was that agents could not look at their own work — they'd conclude no
    renderer existed at all. See knowledge-base/knowledge/issues/vm_workspace_missing_browser_exec.md.

    Why serve over HTTP instead of patching the watchdog: patching a vendored
    library's security control is fragile across upgrades, and browser-use is
    pinned but not frozen. Navigating to a real ``http://`` URL is the supported
    path and needs no patching.

    Why the root is bounded: a page served from ``http://127.0.0.1:<port>`` shares
    an origin with everything else under that port, so the served root is exactly
    what a rendered page could fetch and exfiltrate. Rooting at ``/`` would let
    any rendered HTML read the whole disk — strictly worse than ``file://``, which
    Chrome gives an opaque origin per document. So the root is the agent's own
    workspace: content the agent already controls, and which by policy holds no
    internal credentials (docs feedback: creds never in the workspace). Files
    outside the workspace fall back to their own directory.

    The listener binds 127.0.0.1 inside the workspace, so it stays within the
    same loopback boundary browser-exec exists to enforce — it is never reachable
    from the pod/VM network.
    """

    def __init__(self) -> None:
        self._servers: dict[str, tuple] = {}
        self._lock = threading.Lock()

    def _root_for(self, path: Path) -> Path:
        """Widest sanctioned directory containing ``path``."""
        for candidate in (SERVE_ROOT, WORKSPACE_DEFAULT):
            if not candidate:
                continue
            try:
                root = Path(candidate).resolve()
            except OSError:
                continue
            if root.is_dir() and path.is_relative_to(root):
                return root
        # Outside the workspace: expose only the file's own directory, so a
        # stray render can't turn into a filesystem-wide read.
        return path.parent

    def _port_for(self, root: Path) -> int:
        key = str(root)
        with self._lock:
            existing = self._servers.get(key)
            if existing is not None:
                return existing[1]
            handler = partial(_QuietHandler, directory=key)
            # Port 0 → kernel picks a free ephemeral port; bound to loopback only.
            httpd = ThreadingHTTPServer(("127.0.0.1", 0), handler)
            port = httpd.server_address[1]
            threading.Thread(target=httpd.serve_forever, daemon=True).start()
            self._servers[key] = (httpd, port)
            log(f"serving {root} on http://127.0.0.1:{port}/ (local file render)")
            return port

    def url_for(self, url: str) -> str:
        """Translate a ``file://`` URL to a served ``http://`` one. Others pass through."""
        parsed = urlparse(url)
        if parsed.scheme != "file":
            return url

        path = Path(unquote(parsed.path)).resolve()
        if not path.exists():
            raise ValueError(f"local file not found: {path}")
        if path.is_dir():
            raise ValueError(f"refusing to render a directory: {path}")

        root = self._root_for(path)
        port = self._port_for(root)
        served = f"http://127.0.0.1:{port}/{quote(path.relative_to(root).as_posix())}"
        if parsed.query:
            served += f"?{parsed.query}"
        if parsed.fragment:
            served += f"#{parsed.fragment}"
        log(f"file:// is blocked by browser-use — rendering via {served}")
        return served

    def close(self) -> None:
        with self._lock:
            for httpd, _ in self._servers.values():
                try:
                    httpd.shutdown()
                    httpd.server_close()
                except Exception:
                    pass
            self._servers.clear()


