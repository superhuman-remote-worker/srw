# =============================================================================
# In-pod plane mount images (connector drivers D7)
# =============================================================================
# Two targets, published as two images:
#
#   opener  srw-fuse-opener: the privileged native sidecar, srw-fuse-opener
#           alone on scratch. It opens /dev/fuse, mounts it and passes the
#           descriptor over a unix socket. No shell, no network code, no
#           rclone.
#   rclone  srw-cloud-mount: the unprivileged native sidecar. Upstream
#           rclone, the srw-cloud-mount supervisor that keeps each of the
#           Pod's mounts up and reports its state, and the opener's
#           fusermount3 client ahead of the real (setuid) one, which is
#           removed. rclone mount2 asks the client to mount, so rclone needs
#           no capability and no /dev/fuse.
#
#   docker build -f docker/Dockerfile.in-pod-mount --target opener .
#   docker build -f docker/Dockerfile.in-pod-mount --target rclone .
# =============================================================================
FROM --platform=$BUILDPLATFORM golang:1.26.8-alpine3.24@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY drivers/fuse-opener/ ./fuse-opener/
COPY drivers/cloud-mount/ ./cloud-mount/
RUN cd fuse-opener && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" \
        GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
        go build -trimpath -ldflags "-s -w" -o /out/srw-fuse-opener . \
    && cd ../cloud-mount && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" \
        GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
        go build -trimpath -ldflags "-s -w" -o /out/srw-cloud-mount .

FROM scratch AS opener
COPY --from=build /out/srw-fuse-opener /srw-fuse-opener
ENTRYPOINT ["/srw-fuse-opener"]

FROM rclone/rclone:1.74.3@sha256:623378ad0ff3ebd5cebf77720843c0e02edfe46e2d5b5ac6bed54c6371780dfb AS rclone
# go-fuse finds fusermount3 on PATH; /usr/local/bin comes first. The setuid
# original goes, so nothing in this image can mount by itself.
RUN rm -f /usr/bin/fusermount3 /usr/bin/fusermount
COPY --from=build /out/srw-fuse-opener /usr/local/bin/srw-fuse-opener
COPY --from=build /out/srw-cloud-mount /usr/local/bin/srw-cloud-mount
RUN ln -s srw-fuse-opener /usr/local/bin/fusermount3
# The opener serves uid 65534 only (--client-uid); the Pod sets it as well.
USER 65534:65534
