# =============================================================================
# srw-voice-qwen-tts — Qwen3-TTS on PyTorch, streamed /v1/audio/speech
# =============================================================================
# The cascade-gpu-rocm profile's TTS (local_voice_gateway.md §6.2, WP4):
# qwen_tts_server.py over faster-qwen3-tts, so the first audio leaves after
# 8 codec frames instead of the whole sentence. The image is small on
# purpose: PyTorch (ROCm build, ~15 GB installed) and the pinned packages
# live in <models>/qwen-tts/runtime, which docker/voice-models/models.py
# fetch --set rocm installs (wheel sha256-pinned, every package pinned), and
# compose mounts it read-only with the model. Local only, never pushed:
#
#   docker build -f docker/voice-models/Dockerfile.qwen-tts \
#       -t srw-voice-qwen-tts:1 docker/voice-models
# =============================================================================
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# PyTorch's ROCm libraries need libatomic.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libatomic1; \
    rm -rf /var/lib/apt/lists/*

COPY qwen_tts_server.py /usr/local/lib/qwen_tts_server.py
COPY qwen_tts_stubs /usr/local/lib/qwen_tts_stubs
USER 65532:65532
# HOME is the tmpfs: MIOpen keeps its kernel database there (no audio).
# MIOpen's exhaustive kernel search made the first sentences take ten times
# longer than they last on an RX 9070 XT; the fast find mode does not.
# With ROCm's profiler-tool registration on, the runtime's event thread
# (AsyncEventsLoop) never sleeps: one CPU core at 100 % while idle, from the
# first tensor on (ROCm 7.2, RX 9070 XT). Nothing here uses those tools.
ENV PORT=8000 VOICES_DIR=/voices HOME=/tmp HF_HUB_OFFLINE=1 \
    MIOPEN_FIND_MODE=FAST HSA_TOOLS_DISABLE_REGISTER=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/qwen-tts/runtime:/usr/local/lib/qwen_tts_stubs \
    MODEL_DIR=/opt/qwen-tts/Qwen3-TTS-12Hz-0.6B-Base
EXPOSE 8000
ENTRYPOINT ["python3", "/usr/local/lib/qwen_tts_server.py"]
