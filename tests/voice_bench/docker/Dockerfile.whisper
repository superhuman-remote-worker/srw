# =============================================================================
# srw-voice-bench-whisper — whisper.cpp (CPU) for the WP0 phone test bench
# =============================================================================
# Transcribes the bench recordings. whisper.cpp v1.9.5 (MIT) is built from the
# GitHub source archive of the release tag, sha256 pinned. The model is NOT in
# the image: scripts/voice-bench.sh downloads ggml-small.bin (multilingual)
# from the official Hugging Face repo at a pinned revision, checks its sha256
# and mounts it at /models.
#
#   docker build -f tests/voice_bench/docker/Dockerfile.whisper \
#       -t srw-voice-bench-whisper:1.9.5 tests/voice_bench
# =============================================================================
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS build

ARG WHISPER_CPP_VERSION=1.9.5
ARG WHISPER_CPP_SHA256=ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential cmake ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src
RUN set -eux; \
    curl -fsSLo whisper.tar.gz \
        "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v${WHISPER_CPP_VERSION}.tar.gz"; \
    echo "${WHISPER_CPP_SHA256}  whisper.tar.gz" | sha256sum -c -; \
    tar xzf whisper.tar.gz; \
    cd "whisper.cpp-${WHISPER_CPP_VERSION}"; \
    # Portable x86-64-v3 build instead of -march=native: the image may run on
    # another machine than the one that built it.
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
        -DGGML_NATIVE=OFF -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON \
        -DGGML_F16C=ON -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF \
        > /tmp/cmake.log; \
    cmake --build build -j"$(nproc)" --target whisper-cli > /tmp/build.log 2>&1 \
        || { tail -60 /tmp/build.log; exit 1; }; \
    install -m 0755 build/bin/whisper-cli /usr/local/bin/whisper-cli

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libgomp1; \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli
USER 65532:65532
ENTRYPOINT ["whisper-cli"]
