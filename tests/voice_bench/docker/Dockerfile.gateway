# Test-only image for the WP2 bench (scripts/voice-bench.sh run --dut srw):
# Python with the voice gateway's two dependencies, hash-pinned. The gateway
# and the driver harness run from the repository, mounted read-only; WP5
# builds the gateway's real image.
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

COPY docker/gateway-requirements.txt /tmp/gateway-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/gateway-requirements.txt \
    && rm /tmp/gateway-requirements.txt

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src
WORKDIR /app
USER 10002:10002
