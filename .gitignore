# Project-specific contents go here
backups/*
workspace/*
./workspace/*
output/*
orchestrator/workspace/*
src/orchestrator/workspace/*
project_documentation/*
docker/certs/*

# Tool caches. Each tool drops a self-ignoring .gitignore inside its cache, so git
# already skips them; listing them here lets IDEs (PyCharm) mark them ignored too.
.import_linter_cache/
.pytest_cache/
.ruff_cache/

# SSH keys (generated for workspace/VM access — never commit)
.dev/
.local-ssh/

# VPN credentials (config.example is tracked, config is not)
docker/vpn/config
docker/vpn/cluster.conf
docker/vpn/research.conf

# MCP configuration files
.mcp.json
.playwright-mcp/*

# Tilt — local runtime state + downloaded extensions cache.
# The Tiltfile itself IS committed (it's the dev-loop recipe).
.tilt-state/
tilt_modules/
.tiltbuild/

# Python virtual environment
venv/
.venv/
env/

# Local environment
.env

# Helm local-dev credentials overlay — values-local.yaml.example is tracked; the real one is NOT
deployment/values-local.yaml
# Generated by scripts/local-dev-up.sh: component image tags pinned to the checkout
deployment/values-local-images.yaml

