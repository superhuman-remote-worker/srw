# =============================================================================
# Docker build context exclusions
# =============================================================================
# Reduces build context size and prevents sensitive/unnecessary files
# from being sent to the Docker daemon.

# Git
.git/
.gitignore

# Virtual environments
venv/
.venv/
env/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Local agent/tool configuration (may contain tokens or private endpoints)
.ai/
.claude/
.codex/
.agents/
.junie/
.mcp.json
.playwright-mcp/

# Environment and secrets
.env
.env.txt
.env.*
!.env.example
deployment/values-local.yaml
docker/certs/
.dev/
.local-ssh/
docker/vpn/config
docker/vpn/cluster.conf
docker/vpn/research.conf

# Workspace data (runtime, not build-time)
workspace/
src/orchestrator/workspace/
backups/
output/

# Test and coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
cockpit/test-results/
cockpit/playwright-report/
cockpit/blob-report/

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Node / Angular build cache
node_modules/
cockpit/node_modules/
cockpit/.angular/
cockpit/dist/

# Documentation (not needed in images)
docs-site/
policy/
knowledge-base/
knowledge-history/
project_documentation/
*.md
!config/**/*.md
!src/orchestrator/config/prompts/*.md
!requirements.txt

# Advanced-LLM-Chat subproject (separate deployment)
Advanced-LLM-Chat/
CitationEngine/

# Private/external repositories cloned into this checkout
HomeLab/
srw-cloud/
KurortEngine/
KurortEngine-salvage/
KurortEngine-extracted/
BetterResavio-KB/

# VM/containerDisk build outputs (not needed by app image builds)
docker/agent-vm-base/

# SQLite databases
*.db

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Docker files (don't need to copy themselves)
.dockerignore
