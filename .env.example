# =============================================================================
# Superhuman Remote Worker — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# Kubernetes is the only supported deployment path: install the Helm chart in
# `helm/` (see helm/README.md), or run it on a local k3d cluster with the
# setup in README.md → "Local Kubernetes Setup (k3d)". In a cluster these
# values come from the chart's ConfigMap and Secret, NOT from this file.
#
# This file is for running the orchestrator/agent/tests on your host against
# a cluster's services (`scripts/port-forward-dbs.sh` tunnels the databases).
# Every credential below is a placeholder — fill in the values your cluster
# actually uses. See knowledge-base/knowledge/deployment.md for the design.

# =============================================================================
# Required: License Acceptance
# =============================================================================
# The Superhuman Remote Worker source is publicly available under the terms in
# the LICENSE file of the source repository. You must explicitly accept those
# terms to run the application — the orchestrator refuses to start otherwise.
#
# See: https://github.com/superhuman-remote-worker/srw/blob/main/LICENSE
LICENSE_TERMS_ACCEPTED=false

# =============================================================================
# Required: Application Encryption Key (AES-GCM at rest)
# =============================================================================
# 32 raw bytes used by src/orchestrator/security/crypto.py to encrypt stored
# credentials (user_api_keys.api_key, project_api_keys.api_key,
# system_api_keys.api_key, user_llm_endpoints.api_key). The orchestrator
# refuses to touch credential-storing code paths without it — so custom
# endpoints, system API keys, and the LLM-seed job all require this.
#
# Accepted formats (auto-detected by crypto._decode_key):
#   - 32 raw bytes, base64-encoded (44 chars incl. padding) — recommended
#   - 32 raw bytes, url-safe base64
#   - a literal 32-char ASCII string (e.g., randAlphaNum 32 output)
#
# Generate one with:
#   python -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
#
# Rotating the key invalidates all existing ciphertexts — users must re-enter
# their keys. For production, manage this via Vault/ESO (see helm/templates/).
# APP_ENCRYPTION_KEY=

# =============================================================================
# Required: LLM Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# System API key seeding (one-time, on `python init.py`)
# -----------------------------------------------------------------------------
# Read once at orchestrator init and inserted into the system_api_keys table.
# After first run, rotate via Settings → Models → Providers — the seeder is
# insert-only and never clobbers existing rows. Mirrors helm/templates/orchestrator/
# llm-seed-job.yaml. See knowledge-base/knowledge/api_key_resolution.md for the wire-format vs
# config-source split.
#
# SEED_OPENAI_API_KEY=
# SEED_ANTHROPIC_API_KEY=
# SEED_GOOGLE_API_KEY=
# SEED_GROQ_API_KEY=
# SEED_OPENROUTER_API_KEY=
# -----------------------------------------------------------------------------

# OpenAI API Key (or compatible API)
# Runtime delivery name — set in the *agent* container's env so per-job
# dispatch can override it. The orchestrator no longer reads this directly;
# orchestrator-side keys come from system_api_keys (seeded above).
# Supports comma-separated keys for automatic fallback:
#   OPENAI_API_KEY=sk-primary-key,sk-backup-key,sk-emergency-key
# On auth/quota errors, the agent rotates to the next key automatically.
# Leave commented unless you need to bypass user_llm_endpoints (e.g. running
# the agent standalone without the orchestrator). Setting this to a placeholder
# value will cause 401s against api.openai.com — leave it unset instead.
# OPENAI_API_KEY=your_openai_api_key_here

# Cooldown for failed API keys in seconds (default: 1800 = 30 minutes)
# After cooldown, exhausted keys become available again (e.g., daily quota resets)
# KEY_COOLDOWN_SECONDS=1800

# Custom OpenAI-compatible endpoints (vLLM, Ollama, llama.cpp, private gateways)
# are configured via Settings → Models → Providers, not via env vars. Each row
# in user_llm_endpoints carries its own base_url + api_key + model list and is
# resolved by the model registry at dispatch time. See
# knowledge-base/knowledge/features/custom_llm_endpoints.md.

# =============================================================================
# Required: PostgreSQL Database
# =============================================================================

# Connection URL for host-side tooling (init.py, tests, backfill scripts).
# Point it at a port-forwarded cluster database — see scripts/port-forward-dbs.sh.
DATABASE_URL=postgresql://srw:CHANGE_ME@localhost:5432/srw

# Individual parameters — the orchestrator composes an internal URL from
# these when DATABASE_URL is not set. In a cluster the chart supplies them
# from the srw Secret; there is deliberately no default password here.
POSTGRES_USER=srw
POSTGRES_PASSWORD=
POSTGRES_DB=srw

# Infrastructure allocation metering (gated defaults). Slice 1 can collect and
# reconcile Kubernetes Pods in shadow without publishing customer usage.
INFRASTRUCTURE_METERING_V2_READS_ENABLED=false
INFRASTRUCTURE_METERING_SOURCE_AWARE_READS_ENABLED=false
INFRASTRUCTURE_METERING_COLLECTOR_ENABLED=false
INFRASTRUCTURE_METERING_SHADOW_ENABLED=false
INFRASTRUCTURE_METERING_PUBLICATION_ENABLED=false
INFRASTRUCTURE_METERING_CUTOVER_ENABLED=false
# Required before collection/publication; choose a stable installation identity.
INFRASTRUCTURE_METERING_STABLE_CLUSTER_ID=
INFRASTRUCTURE_METERING_DEPLOYMENT_MODE=dedicated
INFRASTRUCTURE_METERING_NAMESPACE_ALLOWLIST=
INFRASTRUCTURE_METERING_RELIST_INTERVAL_SECONDS=300
INFRASTRUCTURE_METERING_STALE_AFTER_SECONDS=900
# VMI lifecycle timestamps outside this receipt-clock window stay uncertain.
INFRASTRUCTURE_METERING_MAX_COLLECTOR_CLOCK_SKEW_SECONDS=300
INFRASTRUCTURE_METERING_LIST_PAGE_SIZE=500
INFRASTRUCTURE_METERING_SCOPE_CONCURRENCY=2
INFRASTRUCTURE_METERING_WATCH_QUEUE_SIZE=10000
INFRASTRUCTURE_METERING_MAX_SNAPSHOT_ITEMS=50000
INFRASTRUCTURE_METERING_MAX_SNAPSHOT_BYTES=67108864
INFRASTRUCTURE_METERING_INGESTION_TICKET_TTL_SECONDS=600
INFRASTRUCTURE_METERING_SNAPSHOT_ITEM_RETENTION_DAYS=7
INFRASTRUCTURE_METERING_DIAGNOSTIC_RETENTION_DAYS=35
INFRASTRUCTURE_METERING_CLEANUP_INTERVAL_SECONDS=300
# Dedicated collector-only transport key. Do not reuse MCP_INTERNAL_KEY.
INFRASTRUCTURE_METERING_INGESTION_KEY=

# =============================================================================
# Required: Vector Database (pgvector for citations, memories + knowledge search index)
# =============================================================================

# Connection URL for host-side tooling (see DATABASE_URL above).
VECTOR_DB_URL=postgresql://srw:CHANGE_ME@localhost:5433/srw_vector

# Individual parameters (same role as POSTGRES_* above)
VECTOR_POSTGRES_USER=srw
VECTOR_POSTGRES_PASSWORD=
VECTOR_POSTGRES_DB=srw_vector

# =============================================================================
# Optional: Additional Services
# =============================================================================

# MongoDB (LLM request archiving) - enables audit trail
# MONGODB_URL=mongodb://localhost:27017/srw_logs

# Tavily (Web Search) — required for web_search tool / instruction builder.
# Tavily is a search engine, not an LLM, so it is managed exclusively as
# an env var (Vault → secret → agent pod env). Not stored in the DB and
# not surfaced under Settings → Models → Providers.
# TAVILY_API_KEY=your_tavily_api_key_here

# Unpaywall (Open Access paper lookup) - required for download_paper fallback
# No registration needed — just provide any valid email for API identification
# UNPAYWALL_EMAIL=your@email.com

# Semantic Scholar (paper metadata & citations) - optional, for higher rate limits
# Register at https://www.semanticscholar.org/product/api#api-key
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Anthropic (Claude models) - required when using claude-* models
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini models) - required when using gemini-* models
# GOOGLE_API_KEY=your_google_api_key_here

# Groq (Fast inference) - required when provider: groq
# GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (300+ models via unified API) - required when using openrouter/* models
# Supports comma-separated keys for automatic fallback (same as OPENAI_API_KEY)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: identify your app on OpenRouter leaderboard
# OPENROUTER_REFERER=https://your-site.com
# OPENROUTER_TITLE=Your App Name

# Codex (ChatGPT Plus/Pro via CLIProxyAPI OAuth proxy) - for codex/* models
# The CLIProxyAPI proxy handles OAuth authentication for your ChatGPT subscription.
# API key is typically not needed (proxy handles auth), but can be set for compatibility.
# Available models (Pro tier):
#   codex/gpt-5.4             - Flagship frontier model, 1.05M context, vision (recommended)
#   codex/gpt-5.3-codex       - Best coding model, 400K context, vision
#   codex/gpt-5.3-codex-spark - Fastest coding, 128K context, text-only (Pro exclusive)
# CODEX_API_KEY=not-needed
# CODEX_BASE_URL=http://localhost:8317/v1

# Codex proxy management (orchestrator → proxy container)
# When CODEX_PROXY_URL is set, init.py seeds a system llm_endpoints row
# labelled "codex-proxy" so admins can attach catalog models to it via
# Settings → Models. The proxy enforces Bearer auth on /v1/* — same key as
# /v0/management/* — so CODEX_MANAGEMENT_KEY is what gets stored on the
# seeded row's api_key.
# CODEX_PROXY_URL=http://localhost:8317
CODEX_MANAGEMENT_KEY=

# =============================================================================
# Optional: Vision Model (for describing visual content) — fallback only
# =============================================================================
# Used when the primary model is text-only (llm.multimodal: false in config).
# A separate multimodal model generates text descriptions of images and
# document pages (charts, diagrams, figures).
#
# Configure the vision model via Settings → Models → Defaults
# (system_settings key llm.default_vision_model) or per-user
# (user_settings.default_vision_model).
# At job dispatch the orchestrator resolves the configured model + endpoint
# from the DB and injects VISION_MODEL/_BASE_URL/_API_KEY into the agent's
# environment for the duration of the job, overriding anything below.
#
# The variables here only take effect when:
#   - the agent runs standalone without the orchestrator, or
#   - no default_vision_model is configured anywhere in the DB.
# Leave them commented unless one of those applies.

# Vision model API key (defaults to OPENAI_API_KEY)
# VISION_API_KEY=your_openai_api_key_here

# Vision model base URL (defaults to OpenAI: https://api.openai.com/v1)
# VISION_BASE_URL=https://api.openai.com/v1

# Vision model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4o-mini, gpt-4.1-mini, or any multimodal model
# VISION_MODEL=gpt-4o

# Request timeout in seconds (default: 120)
# VISION_TIMEOUT=120

# =============================================================================
# Optional: Audio Transcription (Whisper) — fallback only
# =============================================================================
# Used when the agent encounters audio files (mp3, wav, m4a, etc.) in the
# workspace. The read_file tool automatically transcribes audio via Whisper.
#
# Same DB-managed flow as VISION_*: configure via Settings → Models → Defaults
# (system_settings key llm.default_whisper_model) or per-user. At dispatch the
# orchestrator injects WHISPER_MODEL/_BASE_URL/_API_KEY into the agent
# environment per job. The variables here are only the standalone /
# unconfigured fallback. Leave commented unless that applies.

# Whisper API key (defaults to OPENAI_API_KEY)
# WHISPER_API_KEY=your_openai_api_key_here

# Whisper API base URL (defaults to OpenAI: https://api.openai.com/v1)
# WHISPER_BASE_URL=https://api.openai.com/v1

# Whisper model (default: whisper-1)
# WHISPER_MODEL=whisper-1

# Request timeout in seconds (default: 300 — audio files can be large)
# WHISPER_TIMEOUT=300

# Language hint for transcription (ISO-639-1, auto-detect if not set)
# Setting this improves accuracy and speed for known-language audio
# WHISPER_LANGUAGE=en

# =============================================================================
# Optional: Workspace Browser (browser-exec daemon)
# =============================================================================
# The browser runs on the workspace image only — the agent pod has no
# Chromium and no local browser path.
#
# Workspace image build pin — must match `.playwright-version` (CI and the
# agent-vm-base Packer build read the file directly). Bump both together.
PLAYWRIGHT_VERSION=1.59.0

# =============================================================================
# Optional: Agent mesh VPN
# =============================================================================

# Tailscale auth key (agent sidecar mesh VPN — production only)
# TAILSCALE_AUTH_KEY=

# =============================================================================
# Optional: Research Proxy (for local development)
# =============================================================================
# Routes outbound research traffic (paywalled papers) through a proxy you
# control. Works with an SSH tunnel: ssh -D 1080 -N user@uni.edu

# Proxy type: "http", "socks5", or "none" (default: none)
# RESEARCH_PROXY_TYPE=socks5

# Proxy host and port
# RESEARCH_PROXY_HOST=localhost
# RESEARCH_PROXY_PORT=1080

# Optional proxy authentication
# RESEARCH_PROXY_USER=
# RESEARCH_PROXY_PASS=

# =============================================================================
# Optional: Email & IMAP (Agent Communication)
# =============================================================================
# SMTP is used for outbound agent emails. IMAP enables direct email reply
# routing (Phase 2 Live Communication). SMTP vars are also used by Keycloak
# notification emails. See knowledge-base/knowledge/features/live_communication.md.

# SMTP_HOST=mail-bridge.internal
# SMTP_PORT=587
# SMTP_USER=agent@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_USE_TLS=true
# SMTP_TRUST_SELF_SIGNED=true
# SMTP_FROM=noreply@example.com
# COCKPIT_EXTERNAL_URL=http://localhost:4200

# Agent email for IMAP reply routing (enables direct email replies)
# AGENT_EMAIL=agent@example.com
# MAIL_DOMAIN=example.com

# Dev-only visual-inspection route (GET /debug/emails) that renders the three
# transactional emails through their real builders. Must stay off in
# production — it is unauthenticated.
EMAIL_PREVIEW_ENABLED=false

# IMAP configuration (for inbound email reply processing)
# IMAP_HOST=mail-bridge.internal
# IMAP_PORT=993
# IMAP_USER=agent@example.com
# IMAP_PASSWORD=your_imap_password
# IMAP_USE_SSL=false
# IMAP_TRUST_SELF_SIGNED=true
# IMAP_POLL_INTERVAL=30

# =============================================================================
# Optional: Webhook Notification Transports (Phase 3 Live Communication)
# =============================================================================
# Additional notification channels alongside email. Each is independently
# optional — unconfigured transports are silently skipped.

# Ntfy push notifications (https://ntfy.sh or self-hosted)
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=srw-notifications
# NTFY_TOKEN=                          # Optional auth token

# Slack incoming webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Discord webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# =============================================================================
# Optional: Gitea (Workspace Delivery)
# =============================================================================
# Internal git server for workspace access. Agents push workspace contents
# after each phase, allowing users to browse deliverables via Gitea web UI.

# GITEA_ADMIN_USER=srw
# GITEA_ADMIN_PASSWORD is required for workspace delivery and has NO code
# default — the orchestrator disables Gitea delivery when it is empty rather
# than falling back to a known password. Supply it from your deployment secret.
# GITEA_ADMIN_PASSWORD=
# GITEA_URL=http://gitea:3000
# GITEA_INTERNAL_URL=http://gitea:3000  # Orchestrator-only API/canonical URL
# GITEA_PORT=3000
# Per-repository deploy-key SSH transport. The internal endpoint must be
# reachable from container workspaces. VM deployments must set an exact routed
# external endpoint; leaving it blank makes VM repository delivery fail closed.
# GITEA_SSH_INTERNAL_HOST=gitea
# GITEA_SSH_INTERNAL_PORT=2222
# GITEA_SSH_EXTERNAL_HOST=
# GITEA_SSH_EXTERNAL_PORT=22
# Additional exact host or host:port endpoints allowed for external OKF KB
# datasources. github.com, gitlab.com, bitbucket.org, and codeberg.org are built
# in. Wildcards, IP literals, and localhost are rejected.
# KB_GIT_ALLOWED_HOSTS=gitea.example.com,gitea.internal:3000
# Optional newline-delimited OpenSSH known_hosts pins for external KB deploy
# keys. When set, StrictHostKeyChecking=yes replaces first-use acceptance.
# KB_GIT_SSH_KNOWN_HOSTS=gitea.example.com ssh-ed25519 AAAA...
# Maximum simultaneous external OKF Git snapshot/embed/test operations per
# orchestrator replica (default: 2).
# KB_EXTERNAL_REINDEX_CONCURRENCY=2
# Periodic native + external OKF freshness sweep interval in seconds (default: 900).
# KB_REINDEX_SWEEP_SECONDS=900

# OIDC client secret is set in the "OIDC Client Secrets" section below
# (single source of truth shared between Keycloak realm import and Gitea).

# =============================================================================
# Optional: Orchestrator Configuration
# =============================================================================

# Orchestrator URL (default: http://localhost:8085)
# ORCHESTRATOR_URL=http://localhost:8085

# Agent identification (auto-detected if not set)
# AGENT_POD_IP=10.0.0.5
# AGENT_POD_PORT=8001
# AGENT_HOSTNAME=agent-pod-1

# Agent config to load (default: creator)
# AGENT_CONFIG=creator

# =============================================================================
# Optional: VM Lifecycle Management
# =============================================================================
# Two provisioning modes (auto-selected):
#
# 1. Direct (same-cluster): Orchestrator calls KubeVirt API directly.
#    Requires: kubernetes Python package + kubeconfig or in-cluster config.
#    Set VM_TEMPLATE_PATH to the KubeVirt VM template YAML.
#
# 2. NATS (cross-cluster): Orchestrator publishes to NATS, VM Controller
#    on the remote agent cluster handles KubeVirt API calls.
#    Requires: nats-py + NATS_URL configured.
#
# If NATS_URL is set, NATS mode takes priority. Otherwise, direct mode is
# used if kubernetes client and VM template are available.
# If neither is available, VM features are disabled.

# NATS server URL (enables cross-cluster mode)
# NATS_URL=nats://localhost:4222

# KubeVirt VM template path (for direct same-cluster provisioning)
# VM_TEMPLATE_PATH=deployment/harvester/vm-template.yaml

# Target namespace for VMs (default: agent-vms)
# VM_NAMESPACE=agent-vms

# Default VM container disk image
# DEFAULT_VM_IMAGE=ghcr.io/superhuman-remote-worker/srw-agent-vm-base:latest

# =============================================================================
# Optional: Instruction Builder (Cockpit AI Chat)
# =============================================================================
# The builder uses its own LLM connection for the instruction chat assistant.
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL if not set.

# Builder API key (defaults to OPENAI_API_KEY or ANTHROPIC_API_KEY based on provider)
# BUILDER_API_KEY=your_api_key_here

# Builder base URL (defaults to OPENAI_BASE_URL for OpenAI-compatible providers)
# BUILDER_BASE_URL=http://your-server:8000/v1

# Builder model (default: openai/RedHatAI/gemma-4-31B-it-FP8-Dynamic)
# Supports codex/ prefix for ChatGPT subscription via CLIProxyAPI, e.g.:
# BUILDER_MODEL=codex/gpt-5.4
# BUILDER_MODEL=openai/RedHatAI/gemma-4-31B-it-FP8-Dynamic

# Force LLM provider: "openai" or "anthropic" (auto-detected from model name)
# BUILDER_LLM_PROVIDER=openai

# =============================================================================
# Optional: Workspace
# =============================================================================

# Base path for job workspaces (default: ./workspace)
# WORKSPACE_PATH=./workspace

# =============================================================================
# Optional: Citation Engine
# =============================================================================
# The citation engine has two distinct config layers:
#
#   1. Infrastructure (DB URLs, behavior knobs) — env-only, set here.
#   2. LLM model + endpoint — DB-managed, fallback only here.
#
# For (2), configure the citation model via Settings → Models → Defaults
# (system_settings key llm.default_citation_model). At job dispatch the
# orchestrator resolves the pin against the model catalog and injects
# CITATION_LLM_MODEL / CITATION_LLM_URL / CITATION_LLM_API_KEY into the agent
# environment for the duration of the job, overriding anything below. CITATION_LLM_API_KEY is
# honoured: when set it is the only key the citation client sends, whatever
# the endpoint. OPENAI_API_KEY is used only when the citation endpoint is
# api.openai.com itself (or CITATION_LLM_URL is unset). A custom
# CITATION_LLM_URL without CITATION_LLM_API_KEY is refused — logged as a
# configuration error, verification falls back to the auxiliary model —
# rather than leaking the chat model's key to that host. For a keyless
# self-hosted endpoint set CITATION_LLM_API_KEY=not-needed.
#
# The CITATION_LLM_* variables here only take effect when:
#   - the agent runs standalone without the orchestrator, or
#   - no default_citation_model is configured anywhere in the DB.

# --- Infrastructure (always env) ------------------------------------------

# Citation database (defaults to VECTOR_DB_URL)
# CITATION_DB_URL=postgresql://srw:CHANGE_ME@localhost:5432/srw

# SQLite fallback path (only used in basic/single-agent mode)
# CITATION_DB_PATH=./citations.db

# Reasoning depth level for analysis (default: high)
# CITATION_REASONING_LEVEL=high

# Minimum reasoning required: none, low, medium, high (default: low)
# CITATION_REASONING_REQUIRED=low

# Skip citation verification step (default: false)
# CITATION_SKIP_VERIFICATION=false

# --- LLM model + endpoint (DB-managed; fallback only) ---------------------

# Citation LLM endpoint
# CITATION_LLM_URL=http://localhost:8080/v1

# Citation LLM API key (required with a custom CITATION_LLM_URL; use
# not-needed for a keyless self-hosted server)
# CITATION_LLM_API_KEY=

# Citation LLM model
# CITATION_LLM_MODEL=gpt-4o-mini

# --- Embedding (read by the upstream citation_engine package) -------------

# Embedding model for vector search (default: qwen3-embedding-8b, 4096 dims)
# Supports any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LiteLLM)
# CITATION_EMBEDDING_MODEL=qwen3-embedding-8b

# Embedding API base URL (workstation via VPN sidecar, or OpenAI)
# CITATION_EMBEDDING_URL=http://localhost:8090/v1

# Embedding API key (not needed for local workstation; set for OpenAI)
# CITATION_EMBEDDING_KEY=

# =============================================================================
# Optional: System Neo4j (Knowledge Base)
# =============================================================================
# System-level Neo4j for the project knowledge base (notes, relationships,
# graph queries). This is a system database like PostgreSQL — required when
# using the knowledge base feature. Separate from DEFAULT_DS_NEO4J_* which
# are external datasources for agent queries.

# NEO4J_URL=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=neo4j_password

# =============================================================================
# Optional: Memory Light (RecallStore) & Knowledge Base Embeddings
# =============================================================================
# Embedding provider for memory system (hybrid search with pgvector),
# knowledge base, and citation engine vector search.
#
# Providers: "local" (custom endpoint, default) or "openrouter"
# Per-account override via user preferences (embedding_provider setting).
# Server-wide default (used when account has no override):
EMBEDDING_PROVIDER=local

# Embedding model (default: qwen3-embedding-8b, 4096 dims)
# For OpenRouter, model is auto-prefixed (e.g. qwen/qwen3-embedding-8b).
# To use a non-Qwen model on OpenRouter, set the full name: openai/text-embedding-3-small
# EMBEDDING_MODEL=qwen3-embedding-8b

# --- Local provider settings (only used when EMBEDDING_PROVIDER=local) ---

# Embedding API key (not needed for local workstation; set for OpenAI)
# EMBEDDING_API_KEY=

# Embedding API base URL (workstation via VPN sidecar, or OpenAI)
# EMBEDDING_BASE_URL=http://localhost:8090/v1

# Embedding vector dimensions (default: 4096 for qwen3-embedding-8b)
# Must match the chosen EMBEDDING_MODEL. If you change the model, update this
# and run rebuild_search_index() to re-embed existing data.
# EMBEDDING_DIMENSIONS=4096


# =============================================================================
# Optional: Default Datasources
# =============================================================================
# External databases that agents can query during job execution.
# If set, a global datasource is created on init. It is available for explicit
# selection but is not automatically attached to new work. See knowledge-base/knowledge/datasources.md.

# Compatibility gate for root REST/session requests that omit datasource_ids.
# New Cockpit versions always send an explicit reviewed array (including []).
# Enable after older clients no longer encode "no connectors" by omission.
# DATASOURCE_DEFAULTS_ON_OMISSION=false

# Coordinated rollout gate for the project-scope + auto-attach connector UI.
# Keep false until every orchestrator replica runs the additive API contract.
# DATASOURCE_SCOPE_AUTO_ATTACH_V1_ENABLED=false

# Default PostgreSQL datasource (external, NOT the orchestrator's own DB)
# DEFAULT_DS_POSTGRESQL_URL=postgres://user:pass@host:5432/analytics_db
# DEFAULT_DS_POSTGRESQL_NAME=Default PostgreSQL
# DEFAULT_DS_POSTGRESQL_READ_ONLY=true

# Default Neo4j datasource
# Neo4j needs separate credentials since bolt:// URLs don't support inline auth.
# DEFAULT_DS_NEO4J_URL=bolt://host:7687
# DEFAULT_DS_NEO4J_USERNAME=neo4j
# DEFAULT_DS_NEO4J_PASSWORD=neo4j_password
# DEFAULT_DS_NEO4J_NAME=Default Neo4j
# DEFAULT_DS_NEO4J_READ_ONLY=true

# Default MongoDB datasource (external, NOT the audit trail DB)
# DEFAULT_DS_MONGODB_URL=mongodb://user:pass@host:27017/mydb
# DEFAULT_DS_MONGODB_NAME=Default MongoDB
# DEFAULT_DS_MONGODB_READ_ONLY=true

# Default WebDAV datasource (Nextcloud, ownCloud, or any WebDAV server)
# DEFAULT_DS_WEBDAV_URL=http://localhost:8800/remote.php/dav/files/admin/
# DEFAULT_DS_WEBDAV_USERNAME=admin
# DEFAULT_DS_WEBDAV_PASSWORD=admin
# DEFAULT_DS_WEBDAV_NAME=Default WebDAV
# DEFAULT_DS_WEBDAV_READ_ONLY=true

# =============================================================================
# Optional: Keycloak SSO (see knowledge-base/knowledge/features/sso_and_cloud_storage.md)
# =============================================================================
# Keycloak is the central identity provider for all system applications.
# The chart deploys it and wires these from the srw Secret; set them here only
# when running the orchestrator on your host against a cluster's Keycloak.

# Orchestrator OIDC token validation. The URL below assumes a port-forward:
#   kubectl --context=k3d-srw -n srw port-forward svc/srw-keycloak 8180:8080
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=srw
KEYCLOAK_CLIENT_ID=orchestrator-api

# Admin API access (for project group sync and user management). These are the
# MASTER realm admin credentials — no default is shipped here on purpose; read
# the real values out of the cluster's Secret (keys KEYCLOAK_ADMIN_USER /
# KEYCLOAK_ADMIN_PASSWORD) rather than inventing a local pair.
# KEYCLOAK_ADMIN_USER=
# KEYCLOAK_ADMIN_PASSWORD=

# Keycloak internal database password (PostgreSQL)
# KC_DB_PASSWORD=keycloak

# SRW realm admin user password (the user you log in with via the cockpit)
# KC_REALM_ADMIN_PASSWORD=admin

# =============================================================================
# Main cloud backend selection (Phase 3)
# =============================================================================
# The orchestrator talks to exactly one main cloud at a time: the backend
# used for user home folders, project folders, and persistent-thread
# session folders. Phase 3 flipped the greenfield default from Nextcloud
# to OpenCloud.
#
# Resolution order (src/orchestrator/services/cloud/config.py::load_main_cloud_config):
#
#   1. If MAIN_CLOUD_BACKEND is set → use it (explicit override).
#   2. Else if any NEXTCLOUD_* var is set (other than NEXTCLOUD_PORT) →
#      nextcloud (in-place upgrade path — existing deployments keep
#      working without any .env changes).
#   3. Else → opencloud (greenfield default).
#
# To force a specific backend regardless of the heuristic:
MAIN_CLOUD_BACKEND=opencloud   # or 'nextcloud'

# =============================================================================
# OpenCloud (default main-cloud backend since Phase 3)
# =============================================================================
# The chart deploys OpenCloud when `opencloud.enabled=true` and seeds its
# Keycloak client from the realm import; see
# knowledge-base/knowledge/operations/opencloud-bootstrap.md.
#
# Zero-config dev: every variable below has a default in
# src/orchestrator/services/cloud/config.py::load_main_cloud_config pointing at a
# locally reachable OpenCloud. Leave them commented out for the "just works"
# path; uncomment + edit to override (real deployments always set these via
# Helm secrets / Vault).

# Internal URL (orchestrator → OpenCloud API). Default: http://localhost:9200
# OPENCLOUD_URL=http://localhost:9200

# Browser-facing URL for deep-links (cockpit → OpenCloud Files).
# Default: same as OPENCLOUD_URL.
# OPENCLOUD_PUBLIC_URL=http://localhost:9200

# Keycloak issuer URL used for client_credentials token requests by the
# orchestrator. The orchestrator runs on the host in dev, so the default
# uses the host-published port (localhost:8180), not the internal
# container hostname. Default: http://localhost:8180/realms/srw
# OPENCLOUD_KEYCLOAK_ISSUER=http://localhost:8180/realms/srw

# Keycloak client for the orchestrator service account (must have
# serviceAccountsEnabled=true and be a member of the `opencloudAdmin`
# group so the access token carries the OpenCloud admin role).
# OPENCLOUD_KEYCLOAK_CLIENT_ID=opencloud-orchestrator
# OPENCLOUD_KEYCLOAK_CLIENT_SECRET is set in the "OIDC Client Secrets"
# section below (single source of truth shared with the Keycloak realm).

# Keycloak group / claim value that maps to the OpenCloud admin role.
# OpenCloud's built-in proxy defaults hardcode these camelCase values:
# `opencloudAdmin`, `opencloudSpaceadmin`, `opencloudUser`, `opencloudGuest`.
# The role_mapping itself is not configurable via env vars (see the
# opencloud binary's `role_mapping` struct tag), so changing this only
# makes sense when you've mounted a custom proxy.yaml.
# OPENCLOUD_ADMIN_ROLE_CLAIM_VALUE=opencloudAdmin

# Default per-Space quota in bytes. Unset means "server default".
# OPENCLOUD_DEFAULT_QUOTA_BYTES=10737418240   # 10 GB

# OIDC wiring for the opencloud service itself (Web UI login, not API).
# OPENCLOUD_OIDC_DISCOVERY_URI=http://keycloak:8080/realms/srw/.well-known/openid-configuration
# OPENCLOUD_OIDC_ISSUER=http://keycloak:8080/realms/srw
# OPENCLOUD_PORT=9200
# OPENCLOUD_LOG_LEVEL=info

# =============================================================================
# Nextcloud (legacy main-cloud backend — opt-in since Phase 3)
# =============================================================================
# Since Phase 3, Nextcloud is opt-in. To run a Nextcloud-backed deployment:
#   1. Set `nextcloud.enabled=true` (and `opencloud.enabled=false`) in your
#      Helm values so the chart deploys Nextcloud + the protected-effect lane.
#   2. Set MAIN_CLOUD_BACKEND=nextcloud explicitly (recommended), or
#      leave it unset and the legacy heuristic will auto-route as long
#      as any NEXTCLOUD_* env var is set.
# See knowledge-base/knowledge/operations/nextcloud-bootstrap.md for the setup guide.

# Internal URL for container-to-container API calls (Group Folders, Provisioning)
# NEXTCLOUD_URL=http://localhost:8800

# Nextcloud admin credentials (used by NextcloudBackend for API calls)
# NEXTCLOUD_ADMIN_USER=admin
# NEXTCLOUD_ADMIN_PASSWORD=admin

# NEXTCLOUD_OIDC_CLIENT_SECRET is set in the "OIDC Client Secrets" section
# below (single source of truth shared with the Keycloak realm import).

# Nextcloud agent service account (for WebDAV access by agents)
# In dev, defaults to "agent-service" / "agent-service-dev". In production, set explicitly.
# NEXTCLOUD_AGENT_USER=agent-service
# NEXTCLOUD_AGENT_PASSWORD=agent-service-dev

# Browser-facing URL for deep-links (cockpit → Nextcloud "Open Files" buttons)
# Internal container-to-container URL remains http://nextcloud:80
# NEXTCLOUD_PUBLIC_URL=http://localhost:8800

# Protected RO-reader authority effects use a separate internal Nginx/FPM
# lane. The HMAC value below is a public local-dev placeholder; replace it for
# any shared environment and never rotate it while cloud_ro_effect_intents are
# retained. The config digest binds the timing knobs and exact verifier bundle;
# repository tests fail if it drifts from the Helm-derived digest.
# NEXTCLOUD_PROTECTED_EFFECT_URL=http://localhost:8801
# NEXTCLOUD_PROTECTED_EFFECT_HMAC_KEY=local-dev-protected-effect-hmac-change-me-000000000000
# NEXTCLOUD_PROTECTED_EFFECT_CONFIG_SHA256=b983c636dba971706dfc027896f1156ee45d4f40a5d87ae7b7cfa8edaa55e237
# NEXTCLOUD_PROTECTED_EFFECT_PORT=8801

# Nextcloud S3 backend (MinIO credentials for object storage). Supplied by
# the chart from the srw Secret; no default is shipped here.
# NEXTCLOUD_S3_ACCESS_KEY=srw
# NEXTCLOUD_S3_SECRET_KEY=

# =============================================================================
# Optional: S3 / MinIO (Snapshot & IDE Session Storage)
# =============================================================================
# Used for workspace snapshots and IDE sessions. Production uses a shared
# MinIO instance; local K3s deploys a dedicated MinIO pod.

# MinIO root credentials. Supplied by the chart from the srw Secret; no
# default is shipped here.
# S3_ACCESS_KEY=srw
# S3_SECRET_KEY=

# =============================================================================
# Optional: OIDC Client Secrets (Keycloak SSO)
# =============================================================================
# Shared secrets between Keycloak and each OIDC-enabled service. The chart's
# realm import (helm/templates/services/keycloak.yaml) references these as
# ${*_OIDC_CLIENT_SECRET} placeholders and resolves them from the srw Secret,
# which is where they belong — Vault/ESO in production, `secrets.values` in
# your local values file. NO values are shipped here: a client secret checked
# into a public template is the same secret on every install.
#
# Set them here only for a host-run orchestrator/MCP that must present the
# same credential as the cluster's Keycloak client. Read each value out of the
# cluster Secret rather than making one up, or the token exchange fails.
#
# IMPORTANT: Use plain ${VAR} placeholders in the realm JSON — NOT ${env.VAR}.
# The env. prefix syntax is from Keycloak 24 and earlier; Keycloak 25+ does
# NOT substitute it for client-secret fields, leaving the literal placeholder
# string as the stored credential (silent breakage).
#
# Changing a secret after first boot requires a Keycloak DB reset to re-import.
# GITEA_OIDC_CLIENT_SECRET=
# NEXTCLOUD_OIDC_CLIENT_SECRET=
# PGADMIN_OIDC_CLIENT_SECRET=
# MCP_OIDC_CLIENT_SECRET=
# OPENCLOUD_KEYCLOAK_CLIENT_SECRET=

# =============================================================================
# Optional: Static workspace pool (no dynamic provisioning)
# =============================================================================
# The orchestrator auto-detects the deployment mode: if the Kubernetes API is
# unreachable it falls back to a pre-existing pool of SSH-reachable workspace
# hosts named here instead of provisioning pods on demand. Kubernetes is the
# supported path; this fallback exists for hosts you operate yourself, and it
# does NOT scale agents dynamically.

# Workspace hostnames (comma-separated). Each host runs SSH + tmux +
# code-server; agents SSH into them. Supports host:port.
# WORKSPACE_HOSTS=workspace-1:30022,workspace-2:30022,workspace-3:30022

# Trusted Ed25519 host-key inventory used by Dynamic Canvas SFTP reads.
# Comma-separated exact `host:port=SHA256:...` entries matching
# WORKSPACE_HOSTS. This is public-key metadata, not a secret. Canvas fails
# closed for Docker workspaces omitted from this inventory. Obtain each value
# from the workspace host over a trusted control plane, e.g.
# `ssh-keygen -lf /var/lib/srw-system/ssh/ssh_host_ed25519_key.pub -E sha256`.
# WORKSPACE_HOST_KEY_FINGERPRINTS=workspace-1:30022=SHA256:replace_me,workspace-2:30022=SHA256:replace_me

# One-time production bootstrap attestation for a newly created static pool.
# Every listed endpoint must also have an exact fingerprint above. Before
# attesting, recreate the container AND replace or independently sanitize its
# persistent /home/agent-host workspace data/volume; regenerating only the SSH
# host key is not a tenant boundary. Unlisted or legacy endpoints enter
# quarantine by default, and a stored quarantine is never promoted merely
# because this variable remains set. Unset this variable immediately after the
# first successful inventory import: leaving it configured could re-attest a
# used endpoint if the inventory database is later restored/rolled back.
# DOCKER_WORKSPACE_BOOTSTRAP_ATTESTED_ENDPOINTS=workspace-1:30022,workspace-2:30022

# Private key the orchestrator and agents use to reach the pool over SSH.
# The chart mounts it read-only and sets this path for you; set it explicitly
# only when running those processes on your host.
# SSH_KEY_PATH=

# Static Docker workspaces cannot be safely reused across tenants by deleting
# files over SSH: prior processes and open sessions may survive. Keep this
# disabled for every shared/multi-user deployment. A single-user developer may
# explicitly opt in to pinned-SSH convenience cleanup/reuse for local disposable
# workspaces. This cleanup is not a security reset.
# DOCKER_WORKSPACE_TRUSTED_DEV_REUSE=false

# Dynamic Canvas workspace-port live preview master gate. Keep disabled until
# the isolated viewer origin, proxy, and real-browser security gates are
# installed. This switch does not configure a wildcard host or make workspace
# ports directly reachable.
CANVAS_LIVE_PREVIEW_ENABLED=false
# Optional comma-separated additions to the built-in reserved-port denylist.
# CANVAS_LIVE_PREVIEW_DENIED_PORTS=8501,9000

# Browser-facing Canvas gateway (separate, stricter dark-ship gate). The chart
# renders it only when the viewer is explicitly enabled, gives it no public
# Service, and still needs an operator-owned wildcard TLS edge which preserves
# the raw request path. A one-shot role Job creates a restricted login after
# migrations; the gateway never receives POSTGRES_* or DATABASE_URL.
# Do not enable these merely to test workspace-port health.
CANVAS_VIEWER_ENABLED=false
CANVAS_VIEWER_DEPLOYMENT_PROFILE=production
# Enabled production value: psl-isolated. Development may use the explicitly
# insecure, cookie-stripping development-cookie-free mode.
CANVAS_VIEWER_COOKIE_MODE=
# Independently registrable user-content domain and exact random-host suffix.
# A dedicated root can use domain=example-userland.test and
# suffix=.example-userland.test for first-level wildcard origins. Production
# requires suffix to equal `.` plus the exact effective-PSL domain.
CANVAS_VIEWER_DOMAIN=
CANVAS_VIEWER_HOST_SUFFIX=
# Comma-separated exact HTTPS origins which may embed the Canvas gateway.
CANVAS_VIEWER_COCKPIT_ORIGINS=
# Operator attestations. Production requires both; every enabled deployment
# requires raw-path preservation at the outermost wildcard edge.
CANVAS_VIEWER_RAW_PATH_VERIFIED=false
CANVAS_VIEWER_PSL_BOUNDARY_VERIFIED=false

# Dedicated gateway database login, reconciled by the chart's one-shot
# canvas-gateway role Job. Use a random value; it must not equal
# POSTGRES_PASSWORD, and no default is shipped here.
CANVAS_VIEWER_POSTGRES_USER=srw_canvas_gateway
CANVAS_VIEWER_POSTGRES_PASSWORD=

# Short-lived viewer/session bounds (seconds).
CANVAS_VIEWER_SESSION_TTL_SECONDS=900
CANVAS_VIEWER_BOOTSTRAP_TTL_SECONDS=60
CANVAS_VIEWER_ATTACHMENT_TTL_SECONDS=1200
CANVAS_VIEWER_REVALIDATE_SECONDS=15

# Per-gateway HTTP and concurrency limits. SSE/WebSocket remain unavailable.
CANVAS_VIEWER_MAX_CONNECTIONS=256
CANVAS_VIEWER_MAX_HTTP_PER_SESSION=16
CANVAS_VIEWER_MAX_HEADER_BYTES=65536
CANVAS_VIEWER_MAX_HEADER_FIELDS=100
CANVAS_VIEWER_MAX_QUERY_BYTES=16384
CANVAS_VIEWER_MAX_QUERY_FIELDS=256
CANVAS_VIEWER_MAX_REQUEST_BODY_BYTES=10485760
CANVAS_VIEWER_MAX_RESPONSE_BODY_BYTES=104857600
CANVAS_VIEWER_CONNECT_TIMEOUT_SECONDS=5
CANVAS_VIEWER_IDLE_TIMEOUT_SECONDS=60
CANVAS_VIEWER_EXCHANGE_TIMEOUT_SECONDS=300

# Read-only Office Canvas (Collabora + WOPI). Disabled installs deliberately
# leave the service origins empty. The chart pulls in the Collabora subchart
# when enabled; supply one operator-managed instance reachable at internalUrl
# and expose the same instance to browsers at the exact public origin.
COLLABORA_ENABLED=false
COLLABORA_INTERNAL_URL=
COLLABORA_PUBLIC_URL=
# Collabora must be able to resolve and reach this URL — it is the
# orchestrator's in-cluster Service address, not a browser-facing one.
COLLABORA_WOPI_BASE_URL=http://orchestrator:8085
COLLABORA_COCKPIT_ORIGIN=http://localhost:4000
COLLABORA_TOKEN_TTL_SECONDS=36000
COLLABORA_DISCOVERY_CACHE_TTL_SECONDS=21600
COLLABORA_DISCOVERY_TIMEOUT_SECONDS=5
CANVAS_MAX_OFFICE_BYTES=26214400
# Required when Office Canvas is enabled. Use a random value of at least
# 32 bytes; this is a secret and must not be exposed to Cockpit.
SESSION_JWT_SECRET=

# Emergency operator-only withdrawal of the managed in-product App Guide and
# its reader. This is a negative, default-off containment switch—not a user
# preference or normal feature flag. Leave false unless a broken guide/reader
# must be withdrawn while you roll back or repair it. Persistent-agent health
# reports `disabled` / `operator_break_glass` while active.
APP_GUIDE_BREAK_GLASS_DISABLED=false

# Temporary operator-owned dark-launch gate for the authenticated, read-only
# product-capability endpoint. This is not a user preference. Keep disabled
# until the M2 shadow-comparison and acceptance gates pass.
PRODUCT_CAPABILITIES_ENDPOINT_ENABLED=false

# Separate default-off canary gate for the persistent-session
# get_product_capabilities tool. Enabling this does not enable the endpoint;
# controlled probes require both operator gates.
PRODUCT_CAPABILITIES_TOOL_ENABLED=false

# Optional public deployment identity used by both the orchestrator and agent.
# Use full 40-64 character source revisions and only a real `sha256:...` image
# digest when the deployment actually runs that digest-pinned artifact. The
# Helm chart derives this from `provenance.*`. On any other run leave this empty
# (reported as unavailable) rather than attesting to a build you cannot prove.
# SRW_DEPLOYMENT_PROVENANCE_JSON={"source_url":"https://github.com/superhuman-remote-worker/srw","documentation_url":"https://github.com/superhuman-remote-worker/srw/tree/main/docs","components":{"orchestrator":{"source_revision":"<full-commit>"},"agent":{"source_revision":"<full-commit>"}}}
SRW_DEPLOYMENT_PROVENANCE_JSON=

# VM hostnames for a static VM pool (comma-separated), same fallback as
# WORKSPACE_HOSTS above. Leave unset when VMs are provisioned by KubeVirt.
# VM_HOSTS=agent-vm-1

# =============================================================================
# Optional: Logging & Debugging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Include third-party library debug output when LOG_LEVEL=DEBUG
# (by default, only app loggers get DEBUG; third-party stays at INFO)
# DEBUG_ALL=1

# Stream LLM tokens to stderr (useful for debugging)
# DEBUG_LLM_STREAM=1
# DEBUG_LLM_TAIL=500

# Show verbose token breakdown per message (very noisy, for context debugging)
# DEBUG_TOKEN_BREAKDOWN=false

# =============================================================================
# Authentication (Keycloak SSO)
# =============================================================================
# Users authenticate via Keycloak. The realm, its clients and the seeded
# admin user are defined by the chart (helm/templates/services/keycloak.yaml);
# their credentials come from the srw Secret, not from this file.
# See knowledge-base/knowledge/features/sso_and_cloud_storage.md for details.

# Admin user (local row seeded during init for app-specific data)
ADMIN_EMAIL=admin@srw.dev
ADMIN_DISPLAY_NAME=Admin

# MCP server/agent authentication (shared with the orchestrator for internal
# delegated routes). The chart mints one into the srw Secret automatically;
# set it here only for host-run processes, using an independently generated
# value that is never exposed to browser code.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# MCP_INTERNAL_KEY=

# Fix MCP dev token — survives database resets so .mcp.json stays valid.
# Must start with "srw_". When set, init uses this instead of generating a random token.
# MCP_DEV_TOKEN=srw_dev_localtoken_do_not_use_in_production
