#!/usr/bin/env python3
"""srw-ssh-proxy — bridge an SSH client to a Superhuman Remote Worker workspace.

Two modes:

    ProxyCommand srw-ssh-proxy --stdio api.srw.works
    srw-ssh-proxy --listen 127.0.0.1:2222 api.srw.works   # for JetBrains Gateway

Standard library only, deliberately: a helper with dependencies reintroduces
the install problem that ruled out websocat (see task-1-brief.md). Python has
no stdlib WebSocket client, so the handshake and framing are implemented here.
``wss://.../api/ssh/attach`` is the only production door — the raw TCP 2222
path is off by default (``sshGateway.tcp.enabled: false``) — so both modes go
over WSS.

CREDENTIALS. The WebSocket upgrade wants a short-lived attach token, minted
by ``POST /api/ssh/attach-token`` and valid for only
``ATTACH_TOKEN_TTL_SECONDS == 300`` seconds server-side
(``orchestrator/services/ssh_gateway_token.py``) — too short to store, so it
is never written to disk. Instead:

  * A durable personal access token (Settings -> API Keys) lives in
    ``$SRW_TOKEN`` or ``~/.config/srw/token``. On *every* connection, before
    the upgrade, this PAT is exchanged for a fresh attach token.
  * ``$SRW_SSH_TOKEN`` is a one-off override: an already-minted attach token
    (e.g. pasted straight from a Cockpit panel) that skips the exchange.

EXIT CODES. The gateway writes its refusal reason (suspended, denied, gone,
...) as a line inside the authenticated SSH channel and sets the SSH exit
status there — both encrypted end-to-end between the user's ``ssh`` and the
gateway's SSH server. This proxy sits *below* that transport: it cannot read
either and must not try (no sniffing the relayed byte stream for the text,
no reinventing the exit-code mapping). It relays opaque frames and exits
non-zero only for its own failures: TLS, a refused upgrade, or a failed
token exchange. ``ssh`` itself surfaces the gateway's reason and exit code.

RELAY DESIGN. Both directions are queued and written with non-blocking
sends, checked against ``select``'s writable set — never a blocking
``sendall`` inside the read branch. A blocking send there, once the peer's
receive window fills during a bulk transfer, would stop the loop from
draining the OTHER direction too, and the two ends would fill each other's
windows and deadlock. Bytes that arrive in the same TCP segment as the
handshake's trailing blank line are seeded into the relay rather than
dropped — the gateway pumps the SSH banner immediately after accepting, so
that coalescing is routine, not a corner case.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import http.client
import json
import os
import select
import socket
import ssl
import struct
import sys
import threading
import time
from urllib.parse import urlparse

OPCODE_CONTINUATION = 0x0
OPCODE_TEXT = 0x1
OPCODE_BINARY = 0x2
OPCODE_CLOSE = 0x8
OPCODE_PING = 0x9
OPCODE_PONG = 0xA

PING_INTERVAL_SECONDS = 20  # Cloudflare closes idle sockets at roughly 100s.

# Defensive cap against a malformed or hostile declared frame length forcing
# unbounded buffering while more bytes are awaited. The gateway itself never
# emits more than PUMP_CHUNK_BYTES == 65536 bytes per frame
# (orchestrator/ssh_gateway.py) -- this stays well above that real contract
# for headroom, but reconciled to the same order of magnitude as
# MAX_QUEUE_BYTES below rather than the 256x gap a 16 MiB cap left against a
# 4 MiB queue cap (ruling N-4).
MAX_FRAME_PAYLOAD = 1 * 1024 * 1024

# Bound how much unwritten data queues per direction before that side's fd
# stops being newly offered to select()'s read set -- backpressure, so a
# destination that can't keep up (a slow local disk during a multi-GB scp, a
# stalled TLS window) doesn't grow the queue without limit. This is a soft
# cap, not a hard one: _pump's ``or sock.pending() > 0`` check still drains
# one already-decrypted chunk into to_local even after sock was dropped from
# the read set for being at cap -- bounded overshoot (at most one
# MAX_FRAME_PAYLOAD-sized frame), not unlimited (ruling N-4).
MAX_QUEUE_BYTES = 4 * 1024 * 1024

# Bound how many bytes _connect will buffer while waiting for the handshake
# response's terminating blank line (b"\r\n\r\n"). Every other buffer in this
# file is capped (MAX_FRAME_PAYLOAD, MAX_QUEUE_BYTES above); this one wasn't
# (M-3) -- a gateway, proxy or on-path attacker that never sends the
# terminator would otherwise make this loop accumulate an unbounded amount of
# memory. Real handshake headers are a few hundred bytes; this is headroom,
# sized like MAX_FRAME_PAYLOAD, not an expected size.
MAX_HANDSHAKE_RESPONSE_BYTES = 1 * 1024 * 1024

# How long _drain_final will keep retrying a queued remainder (typically a
# CLOSE echo) before giving up. Bounded so a wedged consumer at shutdown
# can't hang _pump's `finally` forever -- that would leak the pump's thread
# and both fds permanently in --listen mode (ruling N-3).
_DRAIN_FINAL_DEADLINE_SECONDS = 5.0

# A non-blocking send/recv that isn't ready yet: normal backpressure, not a
# failure. ssl.SSLWant{Read,Write}Error are OSError subclasses distinct from
# BlockingIOError (TLS can want a read to satisfy a write and vice versa).
_WOULD_BLOCK = (BlockingIOError, ssl.SSLWantWriteError, ssl.SSLWantReadError)

# Sentinel _recv_available returns when a read specifically needs a WRITE to
# make progress (SSL_read wanting to flush e.g. a TLS 1.3 KeyUpdate response
# or TLS 1.2 renegotiation data) and the send side isn't ready. This is NOT
# just another _WOULD_BLOCK case (ruling R-1): a plain SSLWantReadError
# self-limits, because OpenSSL only raises it after fully draining the
# kernel receive buffer, so select() genuinely blocks on the next call.
# SSLWantWriteError does not self-limit that way on the READ path -- the fd
# can stay genuinely readable (more encrypted bytes keep arriving, or bytes
# already sit in the kernel buffer) while the real blocking condition is a
# full SEND buffer, which a read-only select() watch never notices. Folding
# it into the plain would-block case, as an earlier round did, made _pump
# call _recv_available again immediately, hit the identical error again,
# forever: measured at ~330,000 calls/sec, ~100% CPU -- a livelock rather
# than the crash it replaced.
_WANTS_WRITE = object()

# RFC 6455 S4.1's fixed GUID, concatenated with the client's nonce and
# SHA-1'd to produce Sec-WebSocket-Accept. Mandated by the spec; not a choice.
_WS_ACCEPT_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

ATTACH_TOKEN_PATH = "/api/ssh/attach-token"


def build_handshake(url: str, token: str, origin: str) -> bytes:
    """The HTTP/1.1 upgrade request.

    Origin and Authorization are both required: the gateway authenticates at
    the HTTP layer before upgrading and validates Origin explicitly (it fails
    closed on an empty allow-list).
    """
    parsed = urlparse(url)
    path = parsed.path or "/"
    if parsed.query:
        path = f"{path}?{parsed.query}"
    nonce = base64.b64encode(os.urandom(16)).decode()
    lines = [
        f"GET {path} HTTP/1.1",
        f"Host: {parsed.hostname}",
        "Upgrade: websocket",
        "Connection: Upgrade",
        f"Sec-WebSocket-Key: {nonce}",
        "Sec-WebSocket-Version: 13",
    ]
    if origin:
        lines.append(f"Origin: {origin}")
    if token:
        lines.append(f"Authorization: Bearer {token}")
    return ("\r\n".join(lines) + "\r\n\r\n").encode()


def _mask(payload: bytes, key: bytes) -> bytes:
    """XOR ``payload`` against ``key`` cycled to its length.

    A generator-expression XOR (``bytes(b ^ key[i % 4] for i, b in
    enumerate(payload))``) measured at ~4.27 ms per 64 KiB -- under 15 MB/s,
    and every byte the user sends or receives pays it. Doing the XOR as one
    big-integer operation instead is roughly an order of magnitude faster
    (ruling I-7) and needs nothing beyond ``int.from_bytes``/``to_bytes``.
    """
    if not payload:
        return b""
    repeated = (key * (len(payload) // len(key) + 1))[: len(payload)]
    return (int.from_bytes(payload, "big") ^ int.from_bytes(repeated, "big")).to_bytes(
        len(payload), "big"
    )


def frame(payload: bytes, opcode: int, mask: bool = True) -> bytes:
    """Encode one WebSocket frame. Clients MUST mask (RFC 6455 SS5.3)."""
    header = bytearray([0x80 | opcode])
    length = len(payload)
    mask_bit = 0x80 if mask else 0x00
    if length < 126:
        header.append(mask_bit | length)
    elif length < 65536:
        header.append(mask_bit | 126)
        header += struct.pack("!H", length)
    else:
        header.append(mask_bit | 127)
        header += struct.pack("!Q", length)
    if not mask:
        return bytes(header) + payload
    key = os.urandom(4)
    return bytes(header) + key + _mask(payload, key)


def parse_frames(buffer: bytes) -> tuple[list[tuple[int, bytes]], bytes]:
    """Decode as many whole frames as `buffer` holds.

    Returns (frames, remainder). A partial frame stays in the remainder — SSH
    is a byte stream and dropping one corrupts the session.

    Raises ``ValueError`` on a length that RFC 6455 forbids (the 64-bit
    form's most significant bit set) or that exceeds ``MAX_FRAME_PAYLOAD`` --
    a malformed or hostile declared length must not force unbounded
    buffering while the rest is awaited.
    """
    frames: list[tuple[int, bytes]] = []
    offset = 0
    while True:
        if len(buffer) - offset < 2:
            break
        first, second = buffer[offset], buffer[offset + 1]
        opcode = first & 0x0F
        masked = bool(second & 0x80)
        length = second & 0x7F
        cursor = offset + 2
        if length == 126:
            if len(buffer) - cursor < 2:
                break
            length = struct.unpack("!H", buffer[cursor : cursor + 2])[0]
            cursor += 2
        elif length == 127:
            if len(buffer) - cursor < 8:
                break
            raw_length = buffer[cursor : cursor + 8]
            if raw_length[0] & 0x80:
                raise ValueError(
                    "srw-ssh-proxy: frame length's most significant bit is "
                    "set, which RFC 6455 forbids"
                )
            length = struct.unpack("!Q", raw_length)[0]
            cursor += 8
        if length > MAX_FRAME_PAYLOAD:
            raise ValueError(
                f"srw-ssh-proxy: frame payload of {length} bytes exceeds "
                f"the {MAX_FRAME_PAYLOAD}-byte cap"
            )
        key = b""
        if masked:
            if len(buffer) - cursor < 4:
                break
            key = buffer[cursor : cursor + 4]
            cursor += 4
        if len(buffer) - cursor < length:
            break
        payload = buffer[cursor : cursor + length]
        if masked:
            payload = _mask(payload, key)
        frames.append((opcode, payload))
        offset = cursor + length
    return frames, buffer[offset:]


# ---------------------------------------------------------------------------
# Credentials: durable PAT -> short-lived attach token, exchanged fresh on
# every connection (the minted token is only valid for 300s server-side).
# ---------------------------------------------------------------------------


def _warn_if_token_file_permissive(path: str) -> None:
    """Warn (as ``ssh`` does for private keys) when the PAT file is
    group/world readable. It holds a bearer credential in a location the
    design's own docstring names as the thing to avoid leaving unprotected
    (``ssh_gateway_token.py``'s "world-readable-by-default location")."""
    try:
        mode = os.stat(path).st_mode
    except OSError:
        return
    if mode & 0o077:
        sys.stderr.write(
            f"srw-ssh-proxy: warning: {path} is readable by group or other "
            f"(mode {oct(mode & 0o777)}); it holds a bearer credential -- "
            "recommend chmod 600\n"
        )


def _load_pat() -> str:
    """The durable personal access token: $SRW_TOKEN, else ~/.config/srw/token."""
    token = os.environ.get("SRW_TOKEN", "").strip()
    if token:
        return token
    path = os.path.expanduser("~/.config/srw/token")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            content = handle.read().strip()
    except OSError:
        return ""
    _warn_if_token_file_permissive(path)
    return content


def _refusal_reason(raw: bytes) -> str:
    """Why the orchestrator refused the PAT, as far as its answer says.

    A scope refusal (``Insufficient token scope: requires chat:write``) is a
    valid token created without the scope the exchange needs, which wants a
    different fix from a revoked or mistyped token — so it gets its own line.
    """
    try:
        detail = json.loads(raw).get("detail")
    except (ValueError, AttributeError):
        detail = None
    if isinstance(detail, str) and detail.startswith("Insufficient token scope"):
        scope = detail.partition("requires ")[2].split(",")[0].strip()
        if scope:
            return (
                f"PAT lacks the {scope} scope; create a token with {scope} "
                "in Settings -> API Keys"
            )
    return "bad or unscoped PAT; check $SRW_TOKEN or ~/.config/srw/token"


def fetch_attach_token(
    host: str,
    pat: str,
    *,
    connection_cls=http.client.HTTPSConnection,
    timeout: float = 15.0,
) -> tuple[str, str]:
    """Exchange a durable PAT for a short-lived attach token.

    Calls ``POST https://<host>/api/ssh/attach-token`` and returns
    ``(token, expires_at)``. Raises ``SystemExit`` with a message that
    distinguishes an authentication refusal (401/403 — a bad or unscoped
    PAT), a malformed HTTP response, a TLS failure, and a plain connection
    error — four different problems that want four different fixes, so a
    single generic message would send someone down the wrong path.
    """
    conn = connection_cls(host, timeout=timeout)
    try:
        conn.request(
            "POST",
            ATTACH_TOKEN_PATH,
            body=b"",
            headers={"Authorization": f"Bearer {pat}"},
        )
        response = conn.getresponse()
        raw = response.read()
    except ssl.SSLError as exc:
        raise SystemExit(f"srw-ssh-proxy: TLS error talking to {host}: {exc}") from exc
    except http.client.HTTPException as exc:
        raise SystemExit(
            f"srw-ssh-proxy: malformed HTTP response from {host}: {exc}"
        ) from exc
    except OSError as exc:
        raise SystemExit(
            f"srw-ssh-proxy: could not reach {host} for a token: {exc}"
        ) from exc
    finally:
        conn.close()

    if response.status != 200:
        if response.status in (401, 403):
            raise SystemExit(
                f"srw-ssh-proxy: token exchange refused ({response.status}): "
                f"{_refusal_reason(raw)}"
            )
        raise SystemExit(
            f"srw-ssh-proxy: token exchange failed ({response.status}): "
            f"{raw.decode(errors='replace')[:200]}"
        )
    try:
        payload = json.loads(raw)
        return payload["token"], payload["expires_at"]
    except (ValueError, KeyError, TypeError) as exc:
        raise SystemExit(f"srw-ssh-proxy: malformed token response: {exc}") from exc


def resolve_ws_token(host: str) -> str:
    """The Authorization bearer to present at the WebSocket upgrade.

    ``SRW_SSH_TOKEN`` is a one-off, already-minted attach token and skips the
    exchange entirely. Otherwise a durable PAT is exchanged for a fresh
    attach token — deliberately not cached, so every connection (each accept
    in ``--listen`` mode included) gets its own, well inside the 300s TTL.
    """
    override = os.environ.get("SRW_SSH_TOKEN", "").strip()
    if override:
        return override
    pat = _load_pat()
    if not pat:
        raise SystemExit(
            "srw-ssh-proxy: no credential found; set $SRW_TOKEN, write "
            "~/.config/srw/token, or set $SRW_SSH_TOKEN to a one-off attach token"
        )
    token, _expires_at = fetch_attach_token(host, pat)
    return token


# ---------------------------------------------------------------------------
# The WSS connection itself.
# ---------------------------------------------------------------------------


def _default_origin(host: str) -> str:
    """Best-effort Origin guess: api.<domain> -> https://cockpit.<domain>.

    The gateway enforces an exact-match Origin allow-list and fails closed,
    so a wrong guess here is a flat, cause-blind 403 (see ``_handshake_error``
    for what actually reaches the client on that status). Pass --origin to
    override.
    """
    return f"https://{host.replace('api.', 'cockpit.', 1)}"


def _handshake_error(status_line: str, origin: str) -> str:
    """Message for a non-101 handshake response.

    A bare 403 here is ambiguous by construction, not just by omission: the
    gateway's pre-accept refusals -- an expired or invalid attach token, a
    rejected Origin, and the handshake rate limit -- are recorded as having
    been measured live to all render as one identical, undifferentiated HTTP
    403 (``orchestrator/ssh_gateway.py``'s WS_TOKEN_REFUSED / WS_ORIGIN_REFUSED
    / WS_RATE_REFUSED). Naming only Origin here would send the most common
    case (an expired token) down the wrong path.
    """
    message = f"srw-ssh-proxy: upgrade refused: {status_line}"
    if "403" in status_line:
        message += (
            f" (sent Origin: {origin!r}; a bare 403 here means the attach "
            "token was expired/invalid, the Origin was rejected, or the "
            "handshake rate limit was hit -- retry for a fresh token, or "
            "pass --origin if the Origin is wrong)"
        )
    return message


def _extract_header(blob: bytes, name: str) -> str:
    """Case-insensitively find one header's value in a raw HTTP header blob."""
    target = name.lower().encode()
    for line in blob.split(b"\r\n"):
        key, sep, value = line.partition(b":")
        if sep and key.strip().lower() == target:
            return value.strip().decode(errors="replace")
    return ""


def _compute_accept(key: str) -> str:
    """RFC 6455 SS4.1: base64(SHA-1(key + the WebSocket GUID))."""
    digest = hashlib.sha1((key + _WS_ACCEPT_GUID).encode()).digest()
    return base64.b64encode(digest).decode()


def _split_handshake_response(response: bytes) -> tuple[str, bytes, bytes]:
    """Split a raw handshake response into (status_line, header_blob, leftover).

    ``leftover`` is whatever arrived after the blank line that ends the HTTP
    headers in the SAME ``recv()`` calls used to read them -- already-arrived
    WebSocket frame bytes, not more header. The gateway accepts and pumps the
    SSH server's banner immediately, so the 101 response and the first data
    frame routinely land in one TCP segment; treating ``leftover`` as
    disposable silently drops the start of the session (ruling C-1).
    """
    header, _, leftover = response.partition(b"\r\n\r\n")
    status = header.split(b"\r\n", 1)[0].decode(errors="replace")
    return status, header, leftover


def _connect(host: str, origin: str) -> tuple[ssl.SSLSocket, bytes]:
    """Open the WSS connection. Returns ``(socket, leftover)`` -- see
    ``_split_handshake_response`` for why ``leftover`` exists and must not be
    discarded."""
    token = resolve_ws_token(host)
    url = f"wss://{host}/api/ssh/attach"
    raw = socket.create_connection((host, 443), timeout=30)
    try:
        context = ssl.create_default_context()
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        sock = context.wrap_socket(raw, server_hostname=host)
    except ssl.SSLError as exc:
        # A bad certificate previously reached the user as a raw traceback --
        # same class of problem as fetch_attach_token's TLS handling, just a
        # different site (wrap_socket does the handshake synchronously here).
        raw.close()
        raise SystemExit(
            f"srw-ssh-proxy: TLS error connecting to {host}: {exc}"
        ) from exc
    except BaseException:
        raw.close()
        raise
    try:
        request = build_handshake(url, token, origin)
        sock.sendall(request)
        response = b""
        while b"\r\n\r\n" not in response:
            chunk = sock.recv(4096)
            if not chunk:
                raise SystemExit("srw-ssh-proxy: gateway closed during handshake")
            response += chunk
            if len(response) > MAX_HANDSHAKE_RESPONSE_BYTES:
                raise SystemExit(
                    "srw-ssh-proxy: handshake response exceeded "
                    f"{MAX_HANDSHAKE_RESPONSE_BYTES} bytes without a "
                    "terminating blank line -- refusing to buffer further"
                )
        status, header, leftover = _split_handshake_response(response)
        if "101" not in status:
            raise SystemExit(_handshake_error(status, origin))
        sent_key = _extract_header(request, "Sec-WebSocket-Key")
        got_accept = _extract_header(header, "Sec-WebSocket-Accept")
        if got_accept != _compute_accept(sent_key):
            raise SystemExit(
                "srw-ssh-proxy: handshake accepted (101) but Sec-WebSocket-Accept "
                "did not match our key -- a proxy or middlebox may be interfering"
            )
        # This timeout was a *connect* timeout; it must not survive onto the
        # live session, where a stalled send would otherwise raise
        # socket.timeout and kill an otherwise-working connection.
        sock.settimeout(None)
        return sock, leftover
    except BaseException:
        sock.close()
        raise


# ---------------------------------------------------------------------------
# The relay loop.
# ---------------------------------------------------------------------------


def _recv_available(sock) -> bytes | None:
    """One or more ``recv`` calls: at least one, plus draining anything
    OpenSSL already decrypted into its own buffer.

    ``select()`` reports the underlying file descriptor readable, not "there
    is decrypted application data waiting" — OpenSSL can decrypt a whole TLS
    record into its internal buffer on one ``recv()`` and leave more of it
    unread. Those bytes will not make the socket readable to ``select()``
    again until another TLS record arrives over the wire, so on a byte
    stream like SSH a naive single ``recv()`` per wakeup can intermittently
    stall. ``sock.pending()`` reports exactly that backlog.

    Returns ``None`` when ``sock`` (non-blocking since ruling I-5) was
    reported readable but no application data was actually available yet --
    a spurious wakeup, or a partial/control-only TLS record (a record split
    across TCP segments on a real MTU, or a post-handshake NewSessionTicket/
    KeyUpdate with nothing behind it) both raise ``SSLWantReadError`` here,
    on any real network path. That must NOT collapse into the same value as
    ``b""``, which means the peer closed the connection cleanly (mirroring
    ``socket.recv``) -- conflating the two, as an earlier version of this
    fix did, makes a spurious wakeup indistinguishable from EOF and tears
    down an otherwise-healthy session (ruling N-1).

    Returns ``_WANTS_WRITE`` -- a third, distinct value -- when the would-
    block is specifically ``SSLWantWriteError``. Folding it into the
    ``None`` case (as the very first version of this fix did) is a second,
    different bug: unlike ``SSLWantReadError``, it does not self-limit, so
    ``_pump`` would call this again immediately, hit the identical error
    again, forever (ruling R-1 -- see ``_WANTS_WRITE``'s own definition for
    the measured cost).
    """
    try:
        chunk = sock.recv(65536)
    except ssl.SSLWantWriteError:
        return _WANTS_WRITE
    except _WOULD_BLOCK:
        return None
    if not chunk:
        return b""
    data = chunk
    while sock.pending() > 0:
        try:
            more = sock.recv(65536)
        except _WOULD_BLOCK:
            break
        if not more:
            break
        data += more
    return data


def _read_available(fd: int) -> bytes | None:
    """One ``os.read()`` from a non-blocking fd.

    Symmetric with ``_recv_available`` and for the same reason (ruling N-2):
    a spurious readability wakeup on ``fd`` must not be mistaken for the
    local process closing its end (``b""``), which ``_pump`` would otherwise
    relay as a fabricated CLOSE and tear down an otherwise-healthy session.
    Lower probability than the TLS case (pipes rarely wake spuriously), but
    the same shape of bug.
    """
    try:
        return os.read(fd, 65536)
    except BlockingIOError:
        return None


def _classify_chunk(chunk) -> str:
    """Classify one ``_recv_available``/``_read_available`` result for
    ``_pump``'s read branches.

    Four-way, not the two-way ``if not chunk`` the original version used:
    ``_WANTS_WRITE`` (``_recv_available`` only -- SSL_read needs a write to
    proceed, ruling R-1) has to be told apart from ``None`` (a plain
    would-block -- no data, the session stays open) has to be told apart
    from ``b""`` (a real, clean close) has to be told apart from non-empty
    bytes (data to process). Pulled out as its own pure function, rather
    than left as the equivalent inline checks, specifically so these exact
    distinctions are pinned by a unit test instead of only showing up in a
    live TLS session under real network conditions (ruling N-1/N-2/R-1).
    """
    if chunk is _WANTS_WRITE:
        return "wants_write"
    if chunk is None:
        return "continue"
    if not chunk:
        return "close"
    return "data"


def _flush_queue(sender, queue: bytearray) -> None:
    """Write as much of ``queue`` as ``sender`` accepts without blocking.

    ``sender`` is a non-blocking ``send``/``os.write``-shaped callable:
    bytes-like in, bytes-actually-written out. Passed a ``memoryview`` of
    ``queue`` rather than ``bytes(queue)`` -- ``os.write``/``socket.send``
    both accept the buffer protocol directly, and copying up to
    ``MAX_QUEUE_BYTES`` on every writable wakeup would be a real cost on the
    critical path of the very multi-GB transfer this design exists to
    survive (ruling N-5). A would-block error means the OS (or OpenSSL's own
    write buffer) isn't ready yet — normal backpressure, not a failure — so
    the remainder just stays queued for the next writable wakeup instead of
    raising (ruling I-5).

    OpenSSL's retry rule for a non-blocking ``SSL_write`` is to retry with
    the SAME buffer, unchanged, until it stops asking for a retry. This
    holds here only because a would-block leaves ``queue`` completely
    untouched and nothing else ever trims or reorders ``to_remote`` except
    this function consuming a confirmed-sent prefix -- so the bytes
    presented on retry are always the same buffer's same prefix. Any future
    change that mutates ``to_remote`` between a failed send and the next
    call would corrupt the TLS stream.

    The ``memoryview`` is used as a context manager so it is explicitly
    released before ``del queue[:sent]`` resizes the same ``bytearray``
    (ruling R-3): a live, unreleased export on a ``bytearray`` makes
    resizing it raise ``BufferError: Existing exports of data``. Real
    ``os.write``/``socket.send`` don't retain the buffer they're passed
    beyond the call, so this was latent rather than live -- but nothing
    about ``sender``'s contract here forbids retaining it, and the explicit
    release makes that safe regardless of what a given ``sender`` does.
    """
    if not queue:
        return
    with memoryview(queue) as view:
        try:
            sent = sender(view)
        except _WOULD_BLOCK:
            return
    if sent:
        del queue[:sent]


def _consume_frames(
    data: bytes, to_local: bytearray, to_remote: bytearray
) -> tuple[bytes, bool]:
    """Parse whole frames out of ``data`` and route their payloads.

    Binary and continuation payloads are queued onto ``to_local`` (bound for
    the SSH client) in order — WS message boundaries don't matter to a raw
    byte stream like SSH, so a fragmented message just needs its
    continuation payloads relayed, not reassembled with any special marker
    (ruling I-2: ``OPCODE_CONTINUATION`` was previously dropped outright). A
    ping is answered with a queued pong; a close queues a close reply and
    stops — any frames after it in ``data`` are not processed, matching a
    peer that has no business sending more once it's closing.

    Returns ``(remainder, should_stop)``: unparsed trailing bytes, and
    whether a CLOSE was seen (the caller should flush ``to_remote`` and
    return).
    """
    frames, remainder = parse_frames(data)
    for opcode, payload in frames:
        if opcode in (OPCODE_BINARY, OPCODE_CONTINUATION):
            to_local += payload
        elif opcode == OPCODE_PING:
            to_remote += frame(payload, OPCODE_PONG)
        elif opcode == OPCODE_CLOSE:
            to_remote += frame(b"", OPCODE_CLOSE)
            return remainder, True
    return remainder, False


def _drain_write_with_deadline(fileobj, write_fn, data, deadline: float) -> None:
    """Write all of ``data`` via the non-blocking ``write_fn``, looping over
    short writes and waiting on ``select`` for ``fileobj`` to become
    writable between attempts, until either everything is sent or
    ``deadline`` (a ``time.monotonic()`` endpoint) passes.

    Two distinct bugs this replaces (ruling N-3): a single ``os.write`` is
    not ``write_all`` -- POSIX permits a short count, most realistically
    after a signal interrupts a partial transfer -- so one call could
    silently drop the tail of ``data``; and re-blocking the fd and calling
    a blocking write/``sendall`` has no bound at all, so a wedged consumer
    could hang this forever. Since this only runs from ``_pump``'s
    ``finally``, that hang previously meant the pump's thread (and both fds)
    leaked permanently in ``--listen`` mode -- the same class of leak
    ruling I-4 was raised for, reopened by a different route. Staying
    non-blocking throughout (rather than re-blocking, as the previous
    version did) is what makes the deadline actually enforceable: a
    deadline check between retries cannot bound a single blocking syscall
    that's already in progress.

    Best-effort: whatever is unsent when the deadline passes is dropped
    silently. There is nothing better to do at the tail of a session that's
    already tearing down.

    Waits on the readiness that actually matches the error (ruling R-4): a
    write can raise ``SSLWantReadError`` too (SSL_write needing to process
    something -- a session ticket, a renegotiation message -- before it can
    finish sending), and writability is likely already true in that case,
    so waiting on it makes ``select()`` return instantly and the retry hits
    the identical error again -- the same confusion R-1 fixed on the read
    side, in miniature here since this is bounded by ``deadline`` rather
    than unbounded.
    """
    view = memoryview(data)
    while view:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return
        try:
            sent = write_fn(view)
        except ssl.SSLWantReadError:
            select.select([fileobj], [], [], min(remaining, 0.5))
            continue
        except _WOULD_BLOCK:
            select.select([], [fileobj], [], min(remaining, 0.5))
            continue
        except OSError:
            return
        if not sent:
            return
        view = view[sent:]


def _drain_final(
    read_fd: int, write_fd: int, sock, to_local: bytearray, to_remote: bytearray
) -> None:
    """Best-effort final flush when the pump is shutting down, then restore
    ``read_fd``, ``write_fd``, and ``sock`` -- all three fds ``_pump`` set
    non-blocking -- to blocking mode unconditionally.

    The flush itself stays non-blocking and bounded by a deadline -- see
    ``_drain_write_with_deadline``. Restoring blocking mode is unconditional,
    not only when there was something to flush: ``O_NONBLOCK`` lives on the
    shared open file description, and the common case at a clean shutdown is
    an *empty* queue -- an earlier version's ``os.set_blocking(write_fd,
    True)`` sat inside ``if to_local:``, so that common case left
    stdin/stdout non-blocking on exit, which can affect whatever else holds
    that same fd (e.g. the parent shell, for a ``--stdio`` run from a
    terminal) after this process is gone (ruling N-6).

    ``read_fd`` specifically -- restored here too, not just ``write_fd`` and
    ``sock`` -- is the half of N-6 that actually causes harm (ruling R-2): a
    version that restored only ``write_fd``/``sock`` passed every test,
    because ``--listen`` mode's ``read_fd == write_fd`` aliasing means
    restoring ``write_fd`` incidentally restores ``read_fd`` too. In
    ``--stdio`` mode they're different fds, and ``read_fd`` is stdin -- the
    exact fd N-6 was raised about, left non-blocking with nothing to alias
    the fix onto it.

    Each direction gets its OWN full ``_DRAIN_FINAL_DEADLINE_SECONDS``
    budget, computed fresh right before that direction's call, not one
    shared deadline computed up front (ruling R-6): a slow or wedged local
    consumer eating the whole budget would otherwise leave the remote
    CLOSE echo -- arguably the more important of the two, since it is what
    tells the gateway the session is over -- with none left. Worst case
    this doubles _drain_final's own total wall time (up to ~2x
    ``_DRAIN_FINAL_DEADLINE_SECONDS`` instead of one shared budget); that
    trade was made deliberately in favor of not starving the CLOSE echo.
    """
    try:
        if to_local:
            _drain_write_with_deadline(
                write_fd,
                lambda data: os.write(write_fd, data),
                to_local,
                time.monotonic() + _DRAIN_FINAL_DEADLINE_SECONDS,
            )
    finally:
        try:
            os.set_blocking(write_fd, True)
        except OSError:
            pass
        try:
            os.set_blocking(read_fd, True)
        except OSError:
            pass
    try:
        if to_remote:
            _drain_write_with_deadline(
                sock,
                sock.send,
                to_remote,
                time.monotonic() + _DRAIN_FINAL_DEADLINE_SECONDS,
            )
    finally:
        try:
            sock.setblocking(True)
        except OSError:
            pass


def _pump(sock, read_fd: int, write_fd: int, initial_buffer: bytes = b"") -> None:
    """Relay bytes between the local SSH client (``read_fd``/``write_fd``) and
    the WSS connection (``sock``) until either side closes.

    Both directions are queued and written with non-blocking sends, checked
    against ``select``'s writable set — never ``sendall`` inside the read
    branch (ruling I-5). A blocking send there, once the peer's receive
    window fills during a bulk transfer, would stop this loop from draining
    the OTHER direction too, and the two ends would fill each other's
    windows and deadlock — exactly what Task 7's ~1 GB ``scp`` gate and a
    JetBrains multi-GB backend pull would hit.

    ``initial_buffer`` seeds already-received bytes — see
    ``_split_handshake_response`` (ruling C-1): the gateway pumps the SSH
    banner immediately after accepting, so it and the 101 response routinely
    arrive in the same TCP segment, after the header terminator ``_connect``
    already consumed.

    ``sock_wants_write`` tracks ``_recv_available`` reporting
    ``_WANTS_WRITE`` (ruling R-1): while true, ``sock`` is dropped from the
    read set entirely (not just skipped when "readable") and added to the
    write set even with nothing queued in ``to_remote`` -- so ``select()``
    genuinely blocks until the socket is actually writable, instead of
    returning instantly because the fd is still readable at the raw level
    (more encrypted bytes, or bytes already buffered) while the real
    blocking condition -- a full send buffer -- never gets waited on at all.
    """

    def local_write(data: bytes) -> int:
        return os.write(write_fd, data)

    in_buffer = bytes(initial_buffer)
    to_local = bytearray()
    to_remote = bytearray()
    last_ping = time.monotonic()
    local_open = True
    closing = False
    sock_wants_write = False

    try:
        sock.setblocking(False)
        os.set_blocking(read_fd, False)
        os.set_blocking(write_fd, False)

        in_buffer, should_stop = _consume_frames(in_buffer, to_local, to_remote)
        if should_stop:
            return

        while True:
            rlist = []
            if local_open and len(to_remote) < MAX_QUEUE_BYTES:
                rlist.append(read_fd)
            if not sock_wants_write and len(to_local) < MAX_QUEUE_BYTES:
                rlist.append(sock)
            wlist = []
            if to_remote or sock_wants_write:
                wlist.append(sock)
            if to_local:
                wlist.append(write_fd)

            # If OpenSSL is already holding decrypted bytes, don't block in
            # select() waiting for more to arrive over the wire — drain them.
            timeout = 0.0 if sock.pending() > 0 else 5.0
            readable, writable, _ = select.select(rlist, wlist, [], timeout)

            now = time.monotonic()
            if now - last_ping > PING_INTERVAL_SECONDS:
                to_remote += frame(b"", OPCODE_PING)
                last_ping = now

            if write_fd in writable:
                _flush_queue(local_write, to_local)
            if sock in writable:
                _flush_queue(sock.send, to_remote)
                sock_wants_write = False

            if read_fd in readable:
                data = _read_available(read_fd)
                outcome = _classify_chunk(data)
                if outcome == "close":
                    to_remote += frame(b"", OPCODE_CLOSE)
                    local_open = False
                    closing = True
                elif outcome == "data":
                    to_remote += frame(data, OPCODE_BINARY)
                # "continue": a spurious wakeup -- no data, try again next
                # iteration. Must not be treated as EOF (ruling N-2).

            if not sock_wants_write and (sock in readable or sock.pending() > 0):
                chunk = _recv_available(sock)
                outcome = _classify_chunk(chunk)
                if outcome == "wants_write":
                    sock_wants_write = True
                elif outcome == "close":
                    return
                elif outcome == "data":
                    in_buffer += chunk
                    in_buffer, should_stop = _consume_frames(
                        in_buffer, to_local, to_remote
                    )
                    if should_stop:
                        return
                # "continue": a spurious wakeup or a partial/control-only TLS
                # record -- no application data yet, not a close (ruling N-1).

            if closing and not to_remote and not to_local:
                return
    finally:
        _drain_final(read_fd, write_fd, sock, to_local, to_remote)


def _report_error(exc: BaseException) -> None:
    """Print one ``srw-ssh-proxy: <message>`` line to stderr.

    Every ``SystemExit`` raised in this file already carries the prefix in
    its own message (that's how every earlier fix's error text was written),
    so prefixing again here doubled it into
    ``srw-ssh-proxy: srw-ssh-proxy: ...``. This checks first, so it's also
    correct for an exception type that DOESN'T carry the prefix (a raw
    ``ValueError``/``OSError`` bubbling up from somewhere new).
    """
    message = str(exc)
    if not message.startswith("srw-ssh-proxy:"):
        message = f"srw-ssh-proxy: {message}"
    sys.stderr.write(f"{message}\n")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="srw-ssh-proxy")
    parser.add_argument("host", help="API hostname, e.g. api.srw.works")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--stdio", action="store_true", help="for ProxyCommand")
    group.add_argument("--listen", metavar="ADDR:PORT", help="for JetBrains Gateway")
    parser.add_argument("--origin", default="", help="Origin header to present")
    args = parser.parse_args(argv)

    origin = args.origin or _default_origin(args.host)

    if args.stdio:
        # Previously unguarded (ruling N-7): a refused handshake
        # (SystemExit), a hostile/malformed frame (ValueError from
        # parse_frames), or a broken pipe surfaced as a raw traceback
        # instead of a clean srw-ssh-proxy: line.
        try:
            sock, leftover = _connect(args.host, origin)
            _pump(sock, sys.stdin.fileno(), sys.stdout.fileno(), leftover)
        except (SystemExit, OSError, ValueError) as exc:
            _report_error(exc)
            return 1
        return 0

    # M-10: argument/bind/accept errors here used to escape as raw
    # tracebacks -- the only place in this file that still did, since
    # --stdio's equivalent guard (ruling N-7) and every other failure path
    # already goes through _report_error.
    bind_host, _, bind_port = args.listen.rpartition(":")
    try:
        bind_port_int = int(bind_port)
    except ValueError:
        _report_error(
            ValueError(
                f"invalid --listen address {args.listen!r}: port must be numeric"
            )
        )
        return 1
    listener = socket.socket()
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        listener.bind((bind_host or "127.0.0.1", bind_port_int))
        listener.listen(8)
    except OSError as exc:
        _report_error(exc)
        listener.close()
        return 1
    sys.stderr.write(f"srw-ssh-proxy: listening on {args.listen}\n")
    sys.stderr.flush()
    try:
        while True:
            try:
                client, _ = listener.accept()
            except OSError as exc:
                # One bad accept() (e.g. EMFILE) must not kill the listener
                # any more than one bad connection kills it in _serve_client.
                _report_error(exc)
                continue
            threading.Thread(
                target=_serve_client, args=(client, args.host, origin), daemon=True
            ).start()
    except KeyboardInterrupt:
        sys.stderr.write("srw-ssh-proxy: interrupted, shutting down\n")
        return 130
    finally:
        listener.close()


def _serve_client(client: socket.socket, host: str, origin: str) -> None:
    sock = None
    try:
        sock, leftover = _connect(host, origin)
        _pump(sock, client.fileno(), client.fileno(), leftover)
    except SystemExit as exc:
        # SystemExit derives from BaseException, not Exception: a bare
        # `except Exception` (as this used to be) never catches it, and
        # threading.excepthook silently drops an uncaught SystemExit in a
        # non-main thread -- every credential/handshake failure raised as
        # SystemExit would vanish with no stderr line at all (ruling I-1).
        _report_error(exc)
    except Exception as exc:  # one bad connection must not kill the listener
        _report_error(exc)
    finally:
        # The outbound WSS socket is this function's own resource -- _connect
        # doesn't (and can't) know when the caller is done with it, so
        # leaking it here leaks an fd and a TLS session per connection
        # (ruling I-4).
        if sock is not None:
            try:
                sock.close()
            except OSError:
                pass
        try:
            client.close()
        except OSError:
            pass


if __name__ == "__main__":
    raise SystemExit(main())
